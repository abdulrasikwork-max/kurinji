# /etc/irl/backup.env  (mode 600, owner root; read by irl-backup.service). NOTHING here is a secret.
#   sudo install -m 600 -o root -g root deploy/env/backup.env.example /etc/irl/backup.env   then edit the values
# Do NOT set IRL_DB_DEFAULTS_FILE here: irl-backup.service sets it from the LoadCredential= file /etc/irl/backup.my.cnf.
IRL_BACKUP_DIR=/var/backups/irl
EVIDENCE_STORAGE_DIR=/var/lib/irl/evidence
SOCIAL_MEDIA_DIR=/var/lib/irl/media
# The database name, if it is not "safesphere" (the name in DB_URL of /etc/irl/backend.env).
# IRL_DB_NAME=safesphere
# The FINGERPRINT (40 hex characters) of the owner's PUBLIC backup key, imported for the user irl (see deploy/LAPTOP.md section 8).
# Never a private key: the private key stays on the owner's other computer.
IRL_BACKUP_GPG_RECIPIENT=
# Folders older than this many days are deleted by backup.sh (only irl-backup-* folders owned by irl).
IRL_BACKUP_KEEP_DAYS=14
