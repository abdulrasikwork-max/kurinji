# Step 2 of 2: the production site. (NOT VERIFIED: nginx is not installed on the machine this was written on; run `nginx -t`.)
#   export IRL_DOMAIN=<your domain>
#   envsubst '${IRL_DOMAIN}' < irl.conf.template | sudo tee /etc/nginx/sites-available/irl >/dev/null
#   sudo nginx -t && sudo systemctl reload nginx
# TLS terminates here; the backend (127.0.0.1:8080) is plain HTTP and reachable only from this host.

# Privacy: the access log deliberately has NO client address, NO query string and NO user agent (the privacy policy draft says no
# address is stored). Time, status, method, path, duration only. Keeping addresses for incident response is the owner's decision
# (and a policy change).
log_format irl_privacy '$time_iso8601 $status $request_method $uri $request_time';

server {
    listen 80;
    listen [::]:80;
    server_name ${IRL_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${IRL_DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${IRL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${IRL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:IRLSSL:10m;
    ssl_session_tickets off;

    # Two years would be typical for HSTS; start with one year and without includeSubDomains/preload (the owner's decision).
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    access_log /var/log/nginx/irl.access.log irl_privacy;
    error_log  /var/log/nginx/irl.error.log warn;

    # Videos are at most 50 MB and uploads are RAW bodies (not multipart); evidence pieces are 1 MB. 60m covers the largest.
    client_max_body_size 60m;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        # SET, never passed through: the backend's rate limits trust this header (FORWARD_HEADERS_STRATEGY=native) and a client
        # must not be able to choose its own address.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stream big uploads to the backend instead of buffering the whole body on disk first.
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
    }

    # The health check for an uptime monitor; not logged (a monitor would fill the log).
    location = /api/health {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        access_log off;
    }

    # The Python moderation service is internal: it is never proxied.
    location /v1/ {
        return 404;
    }

    # Static pages whose TEXT is the owner's (privacy policy, how to delete an account without the app). Put the files in
    # /var/www/irl/. Play and the pilot need public URLs for both.
    location = /privacy {
        alias /var/www/irl/privacy.html;
        default_type text/html;
    }
    location = /delete-account {
        alias /var/www/irl/delete-account.html;
        default_type text/html;
    }

    location / {
        return 404;
    }
}
