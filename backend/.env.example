# Copy this file to ".env" (same folder) and fill in your own values. ".env" is git-ignored.
# The values below are PLACEHOLDERS. JWT_SECRET is deliberately too short: the backend refuses to
# start until you replace it with your own random value of at least 32 characters.
DB_USERNAME=safesphere
DB_PASSWORD=change-me
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=change-me
# DB_URL=jdbc:mysql://localhost:3306/safesphere?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# JWT_EXPIRATION=24h
# Phase 5 Evidence Vault (both optional):
# EVIDENCE_STORAGE_DIR=evidence-store
# PUBLIC half of the vault recovery key, printed by:
#   java -cp target/classes com.safesphere.backend.evidence.tools.VaultKeyTool generate <path-outside-the-repo>\vault-private.pem
# Never put the PRIVATE key here or anywhere on the server.
# EVIDENCE_VAULT_PUBLIC_KEY=MIIBojANBgkqhkiG9w0BAQEFAAOCAY8A...
# Phase 17B phone verification (docs/PHASE17B.md). Default OTP_PROVIDER=DEV_FILE: NO SMS is sent; each code is written
# to OTP_DEV_FILE (default: kurinji-dev-otp.txt in the temp folder) on this computer for testing.
# Real SMS through Fast2SMS: complete KYC and a first Rs 100 top-up on fast2sms.com, create a Dev API key, then set:
# OTP_PROVIDER=FAST2SMS
# FAST2SMS_API_KEY=change-me
# Optional: a separate key for stored code hashes (32+ characters; otherwise derived from JWT_SECRET):
# OTP_SECRET=change-me-to-32-or-more-random-characters
# OTP_DEV_FILE=C:\path\to\dev-otp.txt
# (V25 e-mail links were removed from the sign-up flow in 17B; MAIL_* / PUBLIC_BASE_URL are no longer read.)
