<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 2: talk to the SafeSphere backend. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Phase 4A/4B. Each runtime permission is requested in context (when an emergency is active or a Safe Walk
        starts), never at launch. 4B adds no new permission.
        - Location (precise or approximate): saved with the person's own emergency record only.
        - POST_NOTIFICATIONS (Android 13+): the ongoing "location is being saved" notification.
        - FOREGROUND_SERVICE(_LOCATION): keeps location updates running with the screen off during an emergency.
        - ACCESS_NETWORK_STATE: knows when the phone is offline, to upload saved points when it is back online.
        Deliberately NOT requested: ACCESS_BACKGROUND_LOCATION, CAMERA, CALL_PHONE, SEND_SMS, READ_SMS / RECEIVE_SMS,
        exact alarms, boot completed.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        N6 (D20, N-104): no SEND_SMS. The phone never texts anyone by itself: the SERVER texts the Safety Circle when the
        person chose it, and the person can always text them from the SMS app (ACTION_SENDTO, no permission).
        "Call 112" uses ACTION_DIAL (the person presses call), so no calling permission is needed.
        Telephony is optional: tablets without SMS can still install the app.
    -->

    <!-- N1: the sound-recording, recording-service and screen-lock permissions left with the Evidence Vault. Never
         declare CAMERA here: an app that declares it but has not been granted it may not use the camera-app intents at all. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- N4 (A2): Create asks whether ANY camera app exists, so its button can be hidden on a phone without one (no
         gallery fallback). Package visibility for this one intent only; no app list is read. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".SafeSphereApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeSphere">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeSphere.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Phase 13F: long-press the icon → SOS (opens the non-exported SosEntryActivity below). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Phase 13F (F11): the SOS shortcut's and tile's target. NOT exported: another app cannot open it, so it
             cannot start an SOS countdown. It records an in-memory request and opens MainActivity. -->
        <activity
            android:name=".feature.emergency.entry.SosEntryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SafeSphere.Trampoline" />

        <!-- Phase 13F (F11): the SOS tile in Quick Settings. Exported only so the system can bind it; the
             BIND_QUICK_SETTINGS_TILE permission means no other app can. -->
        <service
            android:name=".feature.emergency.entry.SosTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_sos"
            android:label="@string/sos_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Started only from a visible screen during an active emergency or walk; not reachable by other apps. -->
        <service
            android:name=".core.tracking.SafetyTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- N6 (D22): the "I'm there" / "More time" buttons of an On my way reminder. Only our own PendingIntent reaches it. -->
        <receiver
            android:name=".feature.safewalk.session.CheckInActionReceiver"
            android:exported="false" />

        <!-- N6 (D22): the On my way alarm (setAndAllowWhileIdle, no permission). Only our own PendingIntent reaches it. -->
        <receiver
            android:name=".feature.safewalk.session.OnMyWayAlarmReceiver"
            android:exported="false" />

        <!-- N7 (D34): the target of every IRL notification tap. NOT exported: only IRL's own PendingIntents reach it, and
             it opens only a fixed list of screens with validated ids. -->
        <activity
            android:name=".core.push.NotificationRouterActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SafeSphere.Trampoline" />

        <!-- N7 (D27): Firebase hands IRL's pushes here (data-only pointers). Not exported: Firebase's own receiver starts it
             inside the app. -->
        <service
            android:name=".core.push.IrlMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- N7 (D27): no token before someone signs in (IRL turns it on itself), no analytics, no delivery-metrics export,
             and no automatic Firebase start-up (IRL sets Firebase up by hand from the build's values). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <!-- The ONE file provider: the camera app writes the ID photo (N3) into cache/id-photo/ and a moment's photo (N4)
             into cache/moment-photo/ (the only paths offered, xml/camera_paths). Not exported; access is granted per
             photo by the TakePicture intent. No CAMERA permission is declared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_paths" />
        </provider>

    </application>

</manifest>
