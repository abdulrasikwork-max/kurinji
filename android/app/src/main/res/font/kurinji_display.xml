<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 16: headlines and the wordmark in Mukta Malar Bold (Ek Type, OFL 1.1, docs/licences): one confident sans that
     draws Tamil and Latin together, so a Tamil headline keeps the same weight. (13F used Young Serif; removed.) -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/mukta_malar_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/mukta_malar_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
