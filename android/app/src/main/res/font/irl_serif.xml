<?xml version="1.0" encoding="utf-8"?>
<!-- IRL (2026-11-12): headlines, place names set as headings and the wordmark in Fraunces SemiBold, 72pt cut (Undercase
     Type, OFL 1.1, docs/licences/Fraunces-OFL.txt): a soft old-style serif with an editorial character. Latin only: a
     Tamil headline falls back to the phone's Tamil face. Body text, names, buttons and every emergency text stay in
     Mukta Malar (kurinji_sans / kurinji_display). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/fraunces_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/fraunces_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
</font-family>
