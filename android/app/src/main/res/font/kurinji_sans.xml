<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 13F: UI and body text. Mukta Malar (Ek Type, OFL 1.1, docs/licences) is drawn for Tamil and Latin together,
     so Tamil, Tanglish and English share size and weight. Regular + Bold; medium labels use kurinji_sans_medium. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/mukta_malar_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/mukta_malar_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/mukta_malar_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/mukta_malar_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
