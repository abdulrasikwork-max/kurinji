<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Used from Profile > Log out: clears the whole back stack and shows Login. -->
    <action
        android:id="@+id/action_global_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <!-- Startup -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.safesphere.app.feature.splash.ui.SplashFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_start"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:destination="@id/todayFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_login"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.safesphere.app.feature.onboarding.ui.OnboardingFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Phase N2: sign-in and sign-up are one flow: number (loginFragment) -> code -> (a new number) name and age -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.safesphere.app.feature.auth.ui.LoginFragment"
        android:label="@string/action_log_in"
        tools:layout="@layout/fragment_login">
        <!-- A code is on its way (back = this screen, to fix the number) -->
        <action
            android:id="@+id/action_login_to_phone_verify"
            app:destination="@id/phoneVerifyFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.safesphere.app.feature.auth.ui.RegisterFragment"
        android:label="@string/title_register"
        tools:layout="@layout/fragment_register">
        <!-- N2: the account exists and this phone is signed in: the profile (handle) comes next -->
        <action
            android:id="@+id/action_register_to_profile"
            app:destination="@id/profileSetupFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true">
            <argument
                android:name="firstRun"
                android:defaultValue="true"
                app:argType="boolean" />
        </action>
        <!-- N3 (N-25): "I'm moving from another number": an admin moves the existing member account here -->
        <action
            android:id="@+id/action_register_to_relink"
            app:destination="@id/relinkFragment" />
    </fragment>

    <fragment
        android:id="@+id/relinkFragment"
        android:name="com.safesphere.app.feature.membership.ui.RelinkFragment"
        android:label="@string/relink_title"
        tools:layout="@layout/fragment_relink" />

    <!-- Phase N3: the MIET community membership ("Get verified"; You, Today and the community screens open it) -->
    <fragment
        android:id="@+id/membershipFragment"
        android:name="com.safesphere.app.feature.membership.ui.MembershipFragment"
        android:label="@string/title_membership"
        tools:layout="@layout/fragment_membership" />

    <!-- Phase N3 (A2): community staff, from "Settings and more" (shown from /api/community/me staff flags; the server
         checks the role on every call) -->
    <fragment
        android:id="@+id/staffDecideFragment"
        android:name="com.safesphere.app.feature.membership.ui.staff.DecideFragment"
        android:label="@string/title_staff_decide"
        tools:layout="@layout/fragment_staff_decide" />
    <fragment
        android:id="@+id/staffListFragment"
        android:name="com.safesphere.app.feature.membership.ui.staff.StaffListFragment"
        android:label="{title}"
        tools:layout="@layout/fragment_staff_list">
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="mode"
            android:defaultValue="LOG"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/staffActionsFragment"
        android:name="com.safesphere.app.feature.membership.ui.staff.StaffActionsFragment"
        android:label="@string/title_staff_actions"
        tools:layout="@layout/fragment_staff_actions" />

    <!-- Phase 17B / N2: "Enter the code"; the right code signs in, or (a new number) opens the name-and-age screen -->
    <fragment
        android:id="@+id/phoneVerifyFragment"
        android:name="com.safesphere.app.feature.auth.ui.PhoneVerifyFragment"
        android:label="@string/title_phone_verify"
        tools:layout="@layout/fragment_phone_verify">
        <action
            android:id="@+id/action_phone_verify_to_start"
            app:destination="@id/todayFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_phone_verify_to_profile"
            app:destination="@id/profileSetupFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true">
            <argument
                android:name="firstRun"
                android:defaultValue="true"
                app:argType="boolean" />
        </action>
        <!-- N2: a number without an account; the code is used up, so back from there goes to the number screen -->
        <action
            android:id="@+id/action_phone_verify_to_register"
            app:destination="@id/registerFragment"
            app:popUpTo="@id/phoneVerifyFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Phase N4: the tabs. Today, (Create = an action), You. Today is the community's wall of the last 24 hours. -->
    <fragment
        android:id="@+id/todayFragment"
        android:name="com.safesphere.app.feature.moments.ui.TodayFragment"
        android:label="@string/today_title"
        tools:layout="@layout/fragment_today" />

    <!-- Phase N5 (D19): Replies, a tab. -->
    <fragment
        android:id="@+id/repliesFragment"
        android:name="com.safesphere.app.feature.replies.ui.RepliesFragment"
        android:label="@string/title_replies"
        tools:layout="@layout/fragment_replies" />

    <!-- Phase N5 (D17, D18): a plan or a private reply (a task screen); a new private reply starts here too. -->
    <fragment
        android:id="@+id/conversationFragment"
        android:name="com.safesphere.app.feature.replies.ui.ConversationFragment"
        android:label="@string/conversation_title"
        tools:layout="@layout/fragment_conversation">
        <argument
            android:name="conversationId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="replyToMoment"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="replyToName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Phase N4: one moment on its own page (a reading screen). -->
    <fragment
        android:id="@+id/momentFragment"
        android:name="com.safesphere.app.feature.moments.ui.MomentFragment"
        android:label="@string/title_moment"
        tools:layout="@layout/fragment_moment">
        <argument
            android:name="momentId"
            app:argType="string" />
    </fragment>

    <!-- Phase N4 (A3): admins schedule the daily question (a task screen under Community staff). -->
    <fragment
        android:id="@+id/questionsAdminFragment"
        android:name="com.safesphere.app.feature.moments.ui.QuestionsAdminFragment"
        android:label="@string/title_questions_admin"
        tools:layout="@layout/fragment_questions_admin" />

    <!-- Phase N4 (A2): Create, opened by the ✚ in the bar (an action, never a tab) or by "Answer" on today's question. -->
    <fragment
        android:id="@+id/createFragment"
        android:name="com.safesphere.app.feature.moments.ui.CreateFragment"
        android:label="@string/title_create"
        tools:layout="@layout/fragment_create">
        <argument
            android:name="questionId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="questionText"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/youFragment"
        android:name="com.safesphere.app.feature.profile.ui.YouFragment"
        android:label="@string/nav_you"
        tools:layout="@layout/fragment_you" />

    <!-- IRL redesign (R4): You → Settings and more (private places, reading, community, account, log out) -->
    <fragment
        android:id="@+id/moreFragment"
        android:name="com.safesphere.app.feature.profile.ui.MoreFragment"
        android:label="@string/title_more"
        tools:layout="@layout/fragment_more" />

    <!-- You → Safety: the safety tools (secondary screen since 13F) -->
    <fragment
        android:id="@+id/safetyFragment"
        android:name="com.safesphere.app.feature.safety.ui.SafetyFragment"
        android:label="@string/nav_safety"
        tools:layout="@layout/fragment_safety">
        <action
            android:id="@+id/action_safety_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- You → Safety → Nearby (Phase 6/8 place signals; a secondary screen since 13F) -->
    <!-- Phase 7: moderator screens (secondary; the server checks the role on every call) -->
    <fragment
        android:id="@+id/moderationFragment"
        android:name="com.safesphere.app.feature.moderation.ui.ModerationFragment"
        android:label="@string/title_moderation"
        tools:layout="@layout/fragment_moderation" />

    <!-- Phase 13D: a reported post, perspective or person (moderators; the server checks the role on every call) -->
    <fragment
        android:id="@+id/contentCaseFragment"
        android:name="com.safesphere.app.feature.moderation.ui.ContentCaseFragment"
        android:label="@string/content_case_title"
        tools:layout="@layout/fragment_content_case">
        <argument
            android:name="caseId"
            app:argType="string" />
    </fragment>

    <!-- Phase 3: Safety Circle and emergency (all secondary screens: toolbar with back arrow, no bottom bar) -->
    <fragment
        android:id="@+id/safetyCircleFragment"
        android:name="com.safesphere.app.feature.safetycircle.ui.SafetyCircleFragment"
        android:label="@string/title_safety_circle"
        tools:layout="@layout/fragment_safety_circle" />

    <fragment
        android:id="@+id/contactFormFragment"
        android:name="com.safesphere.app.feature.safetycircle.ui.ContactFormFragment"
        android:label="@string/title_contact_form"
        tools:layout="@layout/fragment_contact_form">
        <!-- -1 means "add a new contact"; any other value is the id of the contact being edited -->
        <argument
            android:name="contactId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/emergencyFragment"
        android:name="com.safesphere.app.feature.emergency.ui.EmergencyFragment"
        android:label="@string/title_emergency"
        tools:layout="@layout/fragment_emergency" />

    <fragment
        android:id="@+id/emergencyHistoryFragment"
        android:name="com.safesphere.app.feature.emergency.ui.EmergencyHistoryFragment"
        android:label="@string/title_emergency_history"
        tools:layout="@layout/fragment_emergency_history" />

    <!-- Phase 4D: one emergency's Emergency Context Packet (owner view) -->
    <fragment
        android:id="@+id/emergencyDetailFragment"
        android:name="com.safesphere.app.feature.emergency.ui.EmergencyDetailFragment"
        android:label="@string/title_emergency_details"
        tools:layout="@layout/fragment_emergency_detail">
        <argument
            android:name="emergencyId"
            app:argType="long" />
    </fragment>

    <!-- Phase 4B: Safe Walk (secondary screen) -->
    <fragment
        android:id="@+id/safeWalkFragment"
        android:name="com.safesphere.app.feature.safewalk.ui.SafeWalkFragment"
        android:label="@string/title_safe_walk"
        tools:layout="@layout/fragment_safe_walk">
        <!-- Phase 13F: filled in by "Going there?"; the person still presses Start. -->
        <argument
            android:name="destinationLabel"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Phase 10A, N2: Account and security (real name, sign out other phones, account deletion; confirmed with texted codes) -->
    <fragment
        android:id="@+id/accountFragment"
        android:name="com.safesphere.app.feature.account.ui.AccountFragment"
        android:label="@string/title_account"
        tools:layout="@layout/fragment_account" />

    <!-- Phase 13A: profiles and connections (secondary screens, reached from Profile until 13F) -->
    <fragment
        android:id="@+id/connectionsFragment"
        android:name="com.safesphere.app.feature.social.ui.ConnectionsFragment"
        android:label="@string/title_connections"
        tools:layout="@layout/fragment_connections" />

    <fragment
        android:id="@+id/profileSetupFragment"
        android:name="com.safesphere.app.feature.social.ui.ProfileSetupFragment"
        android:label="@string/title_social_profile"
        tools:layout="@layout/fragment_profile_setup">
        <!-- Phase 17A: opened by the app only to confirm the age; closes after confirming. -->
        <argument
            android:name="ageOnly"
            android:defaultValue="false"
            app:argType="boolean" />
        <!-- Phase 17B: right after a new account's phone was verified: "Choose your handle", then Today -->
        <argument
            android:name="firstRun"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_profile_setup_to_start"
            app:destination="@id/todayFragment"
            app:popUpTo="@id/profileSetupFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/personProfileFragment"
        android:name="com.safesphere.app.feature.social.ui.PersonProfileFragment"
        android:label="@string/title_person_profile"
        tools:layout="@layout/fragment_person_profile">
        <!-- Exactly one of the two is set: a handle typed in "Find someone", or a profile id from a list. -->
        <argument
            android:name="handle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="profileId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/blockedMutedFragment"
        android:name="com.safesphere.app.feature.social.ui.BlockedMutedFragment"
        android:label="@string/title_blocked_muted"
        tools:layout="@layout/fragment_blocked_muted" />

    <!-- Phase 13D: one's own reports and the community guidelines (reached from Connections and the report dialog) -->
    <fragment
        android:id="@+id/myReportsFragment"
        android:name="com.safesphere.app.feature.social.ui.MyReportsFragment"
        android:label="@string/my_reports_title"
        tools:layout="@layout/fragment_my_reports" />

    <fragment
        android:id="@+id/guidelinesFragment"
        android:name="com.safesphere.app.feature.social.ui.GuidelinesFragment"
        android:label="@string/guidelines_title"
        tools:layout="@layout/fragment_guidelines" />

    <!-- Secondary screens -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.safesphere.app.feature.settings.ui.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_about"
            app:destination="@id/aboutFragment" />
        <action
            android:id="@+id/action_settings_to_terms"
            app:destination="@id/termsFragment" />
        <action
            android:id="@+id/action_settings_to_privacy_policy"
            app:destination="@id/privacyPolicyFragment" />
    </fragment>

    <!-- N7 (D36): Safety Circles you are in, and an SOS from your people -->
    <fragment
        android:id="@+id/circlesFragment"
        android:name="com.safesphere.app.feature.safetycircle.ui.CirclesFragment"
        android:label="@string/title_circles"
        tools:layout="@layout/fragment_circles" />
    <fragment
        android:id="@+id/circleSosFragment"
        android:name="com.safesphere.app.feature.safetycircle.ui.CircleSosFragment"
        android:label="@string/title_circle_sos"
        tools:layout="@layout/fragment_circle_sos">
        <argument
            android:name="emergencyId"
            app:argType="long" />
    </fragment>

    <!-- N7 (D31): Settings → Notifications -->
    <fragment
        android:id="@+id/notificationSettingsFragment"
        android:name="com.safesphere.app.feature.settings.ui.NotificationSettingsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notification_settings" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.safesphere.app.feature.settings.ui.info.AboutFragment"
        android:label="@string/title_about"
        tools:layout="@layout/fragment_info_page" />

    <fragment
        android:id="@+id/termsFragment"
        android:name="com.safesphere.app.feature.settings.ui.info.TermsFragment"
        android:label="@string/title_terms"
        tools:layout="@layout/fragment_info_page" />

    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.safesphere.app.feature.settings.ui.info.PrivacyPolicyFragment"
        android:label="@string/title_privacy_policy"
        tools:layout="@layout/fragment_info_page" />
</navigation>
