<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Used from Profile > Log out: clears the whole back stack and shows Login. -->
    <action
        android:id="@+id/action_global_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <!-- Startup -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.safesphere.app.feature.splash.ui.SplashFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_start"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:destination="@id/discoverFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_login"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.safesphere.app.feature.onboarding.ui.OnboardingFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Authentication UI (Phase 1 preview only) -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.safesphere.app.feature.auth.ui.LoginFragment"
        android:label="@string/action_log_in"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_forgot_password"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_login_to_start"
            app:destination="@id/discoverFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.safesphere.app.feature.auth.ui.RegisterFragment"
        android:label="@string/title_register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_start"
            app:destination="@id/discoverFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.safesphere.app.feature.auth.ui.ForgotPasswordFragment"
        android:label="@string/title_forgot_password"
        tools:layout="@layout/fragment_forgot_password" />

    <!-- Phase 13F: the tabs. Discover · (Share = an action, opens composeFragment) · Cocoon · You -->
    <fragment
        android:id="@+id/discoverFragment"
        android:name="com.safesphere.app.feature.social.ui.DiscoverFragment"
        android:label="@string/title_discover"
        tools:layout="@layout/fragment_discover" />

    <fragment
        android:id="@+id/cocoonFragment"
        android:name="com.safesphere.app.feature.social.ui.CocoonFragment"
        android:label="@string/title_cocoon"
        tools:layout="@layout/fragment_cocoon" />

    <fragment
        android:id="@+id/youFragment"
        android:name="com.safesphere.app.feature.profile.ui.YouFragment"
        android:label="@string/nav_you"
        tools:layout="@layout/fragment_you" />

    <!-- You → Safety: the safety tools (secondary screen since 13F) -->
    <fragment
        android:id="@+id/safetyFragment"
        android:name="com.safesphere.app.feature.safety.ui.SafetyFragment"
        android:label="@string/nav_safety"
        tools:layout="@layout/fragment_safety">
        <action
            android:id="@+id/action_safety_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- You → Safety → Nearby (Phase 6/8 place signals; a secondary screen since 13F) -->
    <fragment
        android:id="@+id/communityFragment"
        android:name="com.safesphere.app.feature.community.ui.CommunityFragment"
        android:label="@string/nav_community"
        tools:layout="@layout/fragment_community" />

    <!-- Phase 7: moderator screens (secondary; the server checks the role on every call) -->
    <fragment
        android:id="@+id/moderationFragment"
        android:name="com.safesphere.app.feature.moderation.ui.ModerationFragment"
        android:label="@string/title_moderation"
        tools:layout="@layout/fragment_moderation">
        <action
            android:id="@+id/action_moderation_to_case"
            app:destination="@id/moderationCaseFragment" />
    </fragment>

    <fragment
        android:id="@+id/moderationCaseFragment"
        android:name="com.safesphere.app.feature.moderation.ui.ModerationCaseFragment"
        android:label="@string/title_moderation_case"
        tools:layout="@layout/fragment_moderation_case">
        <argument
            android:name="caseId"
            app:argType="string" />
    </fragment>

    <!-- Phase 13D: a reported post, perspective or person (moderators; the server checks the role on every call) -->
    <fragment
        android:id="@+id/contentCaseFragment"
        android:name="com.safesphere.app.feature.moderation.ui.ContentCaseFragment"
        android:label="@string/content_case_title"
        tools:layout="@layout/fragment_content_case">
        <argument
            android:name="caseId"
            app:argType="string" />
    </fragment>

    <!-- Phase 3: Safety Circle and emergency (all secondary screens: toolbar with back arrow, no bottom bar) -->
    <fragment
        android:id="@+id/safetyCircleFragment"
        android:name="com.safesphere.app.feature.safetycircle.ui.SafetyCircleFragment"
        android:label="@string/title_safety_circle"
        tools:layout="@layout/fragment_safety_circle" />

    <fragment
        android:id="@+id/contactFormFragment"
        android:name="com.safesphere.app.feature.safetycircle.ui.ContactFormFragment"
        android:label="@string/title_contact_form"
        tools:layout="@layout/fragment_contact_form">
        <!-- -1 means "add a new contact"; any other value is the id of the contact being edited -->
        <argument
            android:name="contactId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/emergencyFragment"
        android:name="com.safesphere.app.feature.emergency.ui.EmergencyFragment"
        android:label="@string/title_emergency"
        tools:layout="@layout/fragment_emergency" />

    <fragment
        android:id="@+id/emergencyHistoryFragment"
        android:name="com.safesphere.app.feature.emergency.ui.EmergencyHistoryFragment"
        android:label="@string/title_emergency_history"
        tools:layout="@layout/fragment_emergency_history" />

    <!-- Phase 4D: one emergency's Emergency Context Packet (owner view) -->
    <fragment
        android:id="@+id/emergencyDetailFragment"
        android:name="com.safesphere.app.feature.emergency.ui.EmergencyDetailFragment"
        android:label="@string/title_emergency_details"
        tools:layout="@layout/fragment_emergency_detail">
        <argument
            android:name="emergencyId"
            app:argType="long" />
    </fragment>

    <!-- Phase 5: the Evidence Vault of one emergency (-1 = all of the person's evidence) -->
    <fragment
        android:id="@+id/evidenceVaultFragment"
        android:name="com.safesphere.app.feature.evidence.ui.EvidenceVaultFragment"
        android:label="@string/title_evidence_vault"
        tools:layout="@layout/fragment_evidence_vault">
        <argument
            android:name="emergencyId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Phase 4B: Safe Walk (secondary screen) -->
    <fragment
        android:id="@+id/safeWalkFragment"
        android:name="com.safesphere.app.feature.safewalk.ui.SafeWalkFragment"
        android:label="@string/title_safe_walk"
        tools:layout="@layout/fragment_safe_walk">
        <!-- Phase 13F: filled in by "Going there?"; the person still presses Start or Check the way. -->
        <argument
            android:name="destinationLabel"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="checkWay"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <!-- Phase 10A: Account and security (password change, account deletion) -->
    <fragment
        android:id="@+id/accountFragment"
        android:name="com.safesphere.app.feature.account.ui.AccountFragment"
        android:label="@string/title_account"
        tools:layout="@layout/fragment_account" />

    <!-- Phase 13A: profiles and connections (secondary screens, reached from Profile until 13F) -->
    <fragment
        android:id="@+id/connectionsFragment"
        android:name="com.safesphere.app.feature.social.ui.ConnectionsFragment"
        android:label="@string/title_connections"
        tools:layout="@layout/fragment_connections" />

    <fragment
        android:id="@+id/profileSetupFragment"
        android:name="com.safesphere.app.feature.social.ui.ProfileSetupFragment"
        android:label="@string/title_social_profile"
        tools:layout="@layout/fragment_profile_setup" />

    <fragment
        android:id="@+id/personProfileFragment"
        android:name="com.safesphere.app.feature.social.ui.PersonProfileFragment"
        android:label="@string/title_person_profile"
        tools:layout="@layout/fragment_person_profile">
        <!-- Exactly one of the two is set: a handle typed in "Find someone", or a profile id from a list. -->
        <argument
            android:name="handle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="profileId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/blockedMutedFragment"
        android:name="com.safesphere.app.feature.social.ui.BlockedMutedFragment"
        android:label="@string/title_blocked_muted"
        tools:layout="@layout/fragment_blocked_muted" />

    <!-- Phase 13D: one's own reports and the community guidelines (reached from Connections and the report dialog) -->
    <fragment
        android:id="@+id/myReportsFragment"
        android:name="com.safesphere.app.feature.social.ui.MyReportsFragment"
        android:label="@string/my_reports_title"
        tools:layout="@layout/fragment_my_reports" />

    <fragment
        android:id="@+id/guidelinesFragment"
        android:name="com.safesphere.app.feature.social.ui.GuidelinesFragment"
        android:label="@string/guidelines_title"
        tools:layout="@layout/fragment_guidelines" />

    <!-- Phase 13B: experiences (reached from Connections and one's own profile until 13F) -->
    <fragment
        android:id="@+id/composeFragment"
        android:name="com.safesphere.app.feature.social.ui.ComposeFragment"
        android:label="@string/title_compose"
        tools:layout="@layout/fragment_compose" />

    <fragment
        android:id="@+id/placePickerFragment"
        android:name="com.safesphere.app.feature.social.ui.PlacePickerFragment"
        android:label="@string/title_place_picker"
        tools:layout="@layout/fragment_place_picker" />

    <fragment
        android:id="@+id/postFragment"
        android:name="com.safesphere.app.feature.social.ui.PostFragment"
        android:label="@string/title_post"
        tools:layout="@layout/fragment_post">
        <argument
            android:name="postId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/myPostsFragment"
        android:name="com.safesphere.app.feature.social.ui.MyPostsFragment"
        android:label="@string/title_my_posts"
        tools:layout="@layout/fragment_my_posts" />

    <fragment
        android:id="@+id/privatePlacesFragment"
        android:name="com.safesphere.app.feature.social.ui.PrivatePlacesFragment"
        android:label="@string/title_private_places"
        tools:layout="@layout/fragment_private_places" />

    <!-- Phase 13C: place and category pages (reading screens: the bottom bar stays) -->
    <fragment
        android:id="@+id/postCollectionFragment"
        android:name="com.safesphere.app.feature.social.ui.PostCollectionFragment"
        android:label="@string/title_post_collection"
        tools:layout="@layout/fragment_post_collection">
        <argument
            android:name="placeId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="category"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="city"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Secondary screens -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.safesphere.app.feature.settings.ui.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_about"
            app:destination="@id/aboutFragment" />
        <action
            android:id="@+id/action_settings_to_terms"
            app:destination="@id/termsFragment" />
        <action
            android:id="@+id/action_settings_to_privacy_policy"
            app:destination="@id/privacyPolicyFragment" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.safesphere.app.feature.settings.ui.info.AboutFragment"
        android:label="@string/title_about"
        tools:layout="@layout/fragment_info_page" />

    <fragment
        android:id="@+id/termsFragment"
        android:name="com.safesphere.app.feature.settings.ui.info.TermsFragment"
        android:label="@string/title_terms"
        tools:layout="@layout/fragment_info_page" />

    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.safesphere.app.feature.settings.ui.info.PrivacyPolicyFragment"
        android:label="@string/title_privacy_policy"
        tools:layout="@layout/fragment_info_page" />
</navigation>
