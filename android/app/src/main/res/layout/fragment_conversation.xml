<?xml version="1.0" encoding="utf-8"?>
<!-- Phase N5 (D17, D18): a plan or a private reply. What it is about (the moment, briefly; a plan's time and where),
     who is in it, until when it is open; the messages, oldest first, with exact times for its members only; then the
     writing box, or one calm line saying why the reader cannot write now. No "seen", no typing, no read state. A new
     private reply starts here: the first message creates it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <com.safesphere.app.core.ui.components.NoticeView
        android:id="@+id/errorNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_padding"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        app:noticeText="@string/error_unknown"
        app:noticeType="warning" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        style="@style/Widget.SafeSphere.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="@string/location_action_retry"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/goneBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/conversation_gone_title"
            android:textAppearance="@style/TextAppearance.Kurinji.Headline.Small" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/conversation_gone_message"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quote_rule"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Kurinji.Overline"
            android:textColor="?attr/colorAccentText" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.Kurinji.Title.Medium" />

        <TextView
            android:id="@+id/planLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/peopleLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <TextView
            android:id="@+id/closesLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openMomentButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversation_open_moment" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/endButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversation_end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- N5 (N-92): after the plan's time, while it is open: share a photo that it happened (once per plan). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/happenedButton"
            style="@style/Widget.Kurinji.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conversation_happened"
            android:visibility="gone"
            app:icon="@drawable/ic_camera" />

        <!-- N6 (D24, N-108): members of an open plan that is not called off: a heads-up note or On my way, through the going bridge. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/goingButton"
            style="@style/Widget.Kurinji.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conversation_going"
            android:visibility="gone"
            app:icon="@drawable/ic_route" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_sm" />

    <TextView
        android:id="@+id/holdHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xs"
        android:text="@string/message_hold_hint"
        android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_tip"
        android:gravity="center_vertical"
        android:minHeight="@dimen/min_touch_target"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:textAppearance="@style/TextAppearance.SafeSphere.Body"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <TextView
            android:id="@+id/composerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayout"
                style="@style/Widget.SafeSphere.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/conversation_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendButton"
                style="@style/Widget.Kurinji.Button.Send"
                android:contentDescription="@string/conversation_send"
                app:icon="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
