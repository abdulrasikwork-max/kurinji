<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 16, restyled in 17E: a heading in the Discover feed ("Talking now", "New in Chennai"...), led by a small lime
     mark. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dot_lime"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Kurinji.Headline.Medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
        android:visibility="gone" />
</LinearLayout>
