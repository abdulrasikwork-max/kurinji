<?xml version="1.0" encoding="utf-8"?>
<!-- IRL redesign (R4): "Settings and more", reached from You. Everything that was the lower half of the You tab:
     private places, the reading choice, community, moderation (moderators only), account, log out. Rows only navigate. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/privacyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/you_section_reading" />

        <!-- Phase 13E (E20): a choice about the viewer only, kept on this phone. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/strongLanguageSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/settings_strong_language_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_strong_language_summary"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/you_section_community" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/communityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/moderationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SocialSectionTitle"
                android:text="@string/profile_moderation_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/moderationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/you_section_account" />

        <TextView
            android:id="@+id/accountLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/accountList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.SafeSphere.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/action_log_out"
            app:icon="@drawable/ic_logout" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
