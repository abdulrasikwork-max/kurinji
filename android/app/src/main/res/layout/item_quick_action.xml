<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="128dp"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/tileIcon"
            style="@style/Widget.SafeSphere.IconCircle"
            android:layout_width="@dimen/icon_circle_size_small"
            android:layout_height="@dimen/icon_circle_size_small"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.safesphere.app.core.ui.components.StatusBadgeView
            android:id="@+id/tileBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
