<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 13F (F6): the safety banners, moved from the old Home screen to every tab and reading screen
     (NavigationRules.bannerDestinations). MainActivity shows them; SessionStatusViewModel decides them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sessionBanners"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:visibility="gone">

    <!-- Phase 4B: a running emergency or Safe Walk, so the person is led back to it -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/activeEmergencyBanner"
        style="@style/Widget.SafeSphere.Card.Emergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:clickable="true"
        android:contentDescription="@string/cd_home_emergency_banner"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:padding="@dimen/space_md"
            android:text="@string/home_emergency_banner"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle"
            android:textColor="?attr/colorOnError" />
    </com.google.android.material.card.MaterialCardView>

    <com.safesphere.app.core.ui.components.NoticeView
        android:id="@+id/activeWalkBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="56dp"
        android:visibility="gone"
        app:noticeText="@string/home_walk_banner"
        app:noticeType="info" />

    <!-- Phase 10A.3: a pending account deletion, for the whole grace period (opens Account) -->
    <com.safesphere.app.core.ui.components.NoticeView
        android:id="@+id/deletionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="56dp"
        android:visibility="gone"
        app:noticeText="@string/account_deletion_pending_soon"
        app:noticeType="warning" />

    <!-- Phase 11 C1: the server needs a sign-in again; nothing was deleted and SOS works (opens sign in) -->
    <com.safesphere.app.core.ui.components.NoticeView
        android:id="@+id/signInBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:clickable="true"
        android:contentDescription="@string/cd_home_sign_in_banner"
        android:focusable="true"
        android:minHeight="56dp"
        android:visibility="gone"
        app:noticeText="@string/home_sign_in_banner"
        app:noticeType="info" />
</LinearLayout>
