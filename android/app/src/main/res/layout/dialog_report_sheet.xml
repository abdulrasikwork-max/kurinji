<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 17F (D-9): the whole Nearby report in ONE step - pick what it is like here, read the privacy line, share.
     No text field and no photo, by design (Phase 6: place signals carry no text, photos or authors).
     17F-V5: this is a bottom sheet, not a system dialog. The choices scroll in the middle; "Share anonymously" and "Cancel"
     sit in a footer OUTSIDE the scroll area, so at 2.0x text size they can never be pushed off the sheet (the system dialog
     gave the choices all the height and clipped Cancel). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/space_md">

    <TextView
        android:id="@+id/reportTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/report_choose_title"
        android:textAppearance="@style/TextAppearance.SafeSphere.SectionTitle" />

    <!-- The only part that scrolls. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/reportScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_sheet_intro"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <RadioGroup
                android:id="@+id/reportChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/reportPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/report_confirm_message"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Always visible: not inside the scroll area. -->
    <LinearLayout
        android:id="@+id/reportFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="vertical">

        <Button
            android:id="@+id/reportShareButton"
            style="@style/Widget.SafeSphere.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/action_share_anonymously" />

        <Button
            android:id="@+id/reportCancelButton"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/action_cancel" />
    </LinearLayout>
</LinearLayout>
