<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 13F (F9): "Going there?", the bridge from reading to going. Each row is something the person may choose;
     nothing starts by itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_md">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/going_there"
        android:textAppearance="@style/TextAppearance.Kurinji.Headline.Medium" />

    <TextView
        android:id="@+id/placeLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

    <TextView
        android:id="@+id/cocoonRow"
        style="@style/Widget.Kurinji.SheetRow"
        android:text="@string/going_save"
        app:drawableStartCompat="@drawable/ic_nav_cocoon" />

    <TextView
        android:id="@+id/tellRow"
        style="@style/Widget.Kurinji.SheetRow"
        android:text="@string/going_tell"
        app:drawableStartCompat="@drawable/ic_message" />

    <TextView
        android:id="@+id/walkRow"
        style="@style/Widget.Kurinji.SheetRow"
        android:text="@string/going_walk"
        app:drawableStartCompat="@drawable/ic_route" />

    <TextView
        android:id="@+id/wayRow"
        style="@style/Widget.Kurinji.SheetRow"
        android:text="@string/going_way"
        app:drawableStartCompat="@drawable/ic_place" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/going_footer"
        android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
</LinearLayout>
