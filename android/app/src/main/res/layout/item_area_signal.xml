<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Read as one item by screen readers (content description set in code). -->
        <LinearLayout
            android:id="@+id/signalSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/signalIcon"
                style="@style/Widget.SafeSphere.IconCircle"
                android:layout_width="@dimen/icon_circle_size_small"
                android:layout_height="@dimen/icon_circle_size_small"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_place" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/signalTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

                <TextView
                    android:id="@+id/signalDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
            </LinearLayout>

            <com.safesphere.app.core.ui.components.StatusBadgeView
                android:id="@+id/signalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:id="@+id/signalDisputed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:drawablePadding="@dimen/space_xs"
            android:text="@string/signal_disputed"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_info" />

        <LinearLayout
            android:id="@+id/answerButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <Button
                android:id="@+id/confirmButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/action_saw_this_too" />

            <Button
                android:id="@+id/noLongerButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/action_no_longer_true" />
        </LinearLayout>

        <TextView
            android:id="@+id/yourAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.SafeSphere.Overline"
            android:visibility="gone" />

        <!-- Phase 7: why the confidence is what it is, and "something is wrong with this" -->
        <LinearLayout
            android:id="@+id/trustButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/whyButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/action_why_confidence" />

            <Button
                android:id="@+id/flagButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/action_flag" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
