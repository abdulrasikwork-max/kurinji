<?xml version="1.0" encoding="utf-8"?>
<!-- Phase N3 (N-25): "I'm moving from another number": the roll number, then a code for an IRL admin. Signed out;
     toolbar + back. FLAG_SECURE (the code, the roll number). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/relinkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/relink_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle" />

        <TextView
            android:id="@+id/relinkIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/relink_intro"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/rollLayout"
            style="@style/Widget.SafeSphere.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:hint="@string/membership_roll_label"
            app:helperText="@string/membership_roll_helper"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rollInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                android:maxLength="24"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/codeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle"
            android:textSize="36sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/codeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/relink_code_hint"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body"
            android:visibility="gone" />

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/errorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:minHeight="@dimen/menu_row_min_height"
            android:text="@string/relink_get_code" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
