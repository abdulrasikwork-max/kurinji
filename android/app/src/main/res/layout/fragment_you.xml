<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 13F (F18), Phase 16, redesigned in 17E: You. The profile head on the ink panel (photo in a lime ring, name,
     handle and city, bio, interests, today's state; no counts, ever), then everything that is theirs: experiences,
     connections, private places; the compact Safety grid (SOS with its emergency look, Safe Walk, Safety Circle,
     Nearby, and all safety tools: it only opens the existing Safety screens); reading choices, community, account. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- The profile head: the ink panel. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerBlock"
            style="@style/Widget.Kurinji.Card.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Photo beside the name; stacked by YouFragment when the text is large (MarksFit ICONS budget). -->
                <LinearLayout
                    android:id="@+id/youHeadRow"
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- The photo (or the initial) in a lime ring; tap to change it. -->
                    <FrameLayout
                        android:id="@+id/photoBlock"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:background="@drawable/bg_ring_lime"
                        android:clickable="true"
                        android:contentDescription="@string/profile_photo_change"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="5dp">

                        <com.safesphere.app.core.ui.components.AvatarView
                            android:id="@+id/youAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/photoProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="?attr/colorLime" />

                        <ImageView
                            android:id="@+id/photoBadge"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_tag_lime"
                            android:importantForAccessibility="no"
                            android:padding="5dp"
                            android:src="@drawable/ic_camera"
                            app:tint="?attr/colorOnLime" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/youNameColumn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/youName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Kurinji.Headline.Large"
                            android:textColor="?attr/colorOnPanel"
                            tools:text="Meena" />

                        <TextView
                            android:id="@+id/youHandle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                            android:textColor="?attr/colorOnPanelVariant"
                            tools:text="\@meena · Chennai" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/youBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/TextAppearance.Kurinji.Body.Large"
                    android:textColor="?attr/colorOnPanel"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/youInterests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                    android:textColor="?attr/colorOnPanelVariant"
                    android:visibility="gone" />

                <!-- Phase 17E (D-7): today's state, for connections only, until midnight. -->
                <LinearLayout
                    android:id="@+id/dailyStateRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start"
                    android:minHeight="@dimen/min_touch_target"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dailyStateChip"
                        style="@style/Widget.Kurinji.Tag"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/daily_state_set"
                        app:drawableTint="?attr/colorOnLime" />

                    <TextView
                        android:id="@+id/dailyStateNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:importantForAccessibility="no"
                        android:text="@string/daily_state_own_note"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                        android:textColor="?attr/colorOnPanelVariant" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfileButton"
                    style="@style/Widget.Kurinji.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/social_edit_profile"
                    app:backgroundTint="?attr/colorLime"
                    app:icon="@drawable/ic_person_outline"
                    app:iconTint="?attr/colorOnLime"
                    android:textColor="?attr/colorOnLime" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- No profile yet (or the age is not confirmed yet): the profile screen handles both. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/noProfileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/you_no_profile"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/makeProfileButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/social_make_profile" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/errorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <!-- Phase 13D: a moderator's pause or reminder about this person (amber, never red), and a review. -->
        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/standingNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/standing_unaffected"
            app:noticeType="warning" />

        <TextView
            android:id="@+id/standingLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/standingReviewButton"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/review_ask"
            android:visibility="gone" />


        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/you_section_social" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/journalList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Phase 17E: the compact Safety grid. It only opens the existing Safety screens (never changes them); the SOS
             tile keeps the emergency look (black, red ring, siren, the word SOS). -->
        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/you_section_safety" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/you_safety_note"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileSos"
                style="@style/Widget.SafeSphere.Card.Emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/cd_sos_tile"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="112dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="?attr/colorOnError"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_siren"
                        app:tint="?attr/colorError" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/you_tile_sos"
                        android:textAppearance="@style/TextAppearance.Kurinji.Headline.Small"
                        android:textColor="?attr/colorOnError" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/you_tile_sos_sub"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                        android:textColor="?attr/colorOnError" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/tileWalk"
                layout="@layout/item_safety_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileCircle"
                layout="@layout/item_safety_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/tileNearby"
                layout="@layout/item_safety_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/allSafetyButton"
            style="@style/Widget.SafeSphere.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/you_safety_all"
            app:icon="@drawable/ic_shield_outline"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnSurface" />

        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/you_section_reading" />

        <!-- Phase 13E (E20): a choice about the viewer only, kept on this phone. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/strongLanguageSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/settings_strong_language_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_strong_language_summary"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/you_section_community" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/communityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/moderationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SocialSectionTitle"
                android:text="@string/profile_moderation_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/moderationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/you_section_account" />

        <TextView
            android:id="@+id/accountLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/accountList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.SafeSphere.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/action_log_out"
            app:icon="@drawable/ic_logout" />

        <!-- A quiet sign-off: the motto and the name in both scripts. -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/motto"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Kurinji.Headline.Small" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/you_signoff"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
