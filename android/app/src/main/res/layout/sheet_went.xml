<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 17G-2 (U5): "How was it?" after "I went". An optional 1 to 5, private to the person; a place shows an average only once
     enough people who went have rated it. The numbers are large buttons with spoken "3 out of 5" (never stars or colour alone). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_md">

        <TextView
            android:id="@+id/wentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/went_sheet_title"
            android:textAppearance="@style/TextAppearance.Kurinji.Headline.Medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/went_sheet_note"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <LinearLayout
            android:id="@+id/ratingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/ratingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearRatingButton"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/went_clear"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            style="@style/Widget.SafeSphere.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/went_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notWentButton"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/went_not" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/went_done" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
