<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 13B: Your experiences. Newest first; more only on an explicit tap.
     Found on a real phone (Galaxy A23, live path): the list used to sit inside a ScrollView with a wrap_content,
     non-scrolling RecyclerView. Such a list lays out only about one screen of items, so with photo cards (nearly a
     screen tall each) the second post was never shown or reachable. The list now scrolls itself (height 0dp, weight 1);
     the buttons above and below it stay in place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <com.safesphere.app.core.ui.components.NoticeView
        android:id="@+id/errorNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        app:noticeText="@string/error_unknown"
        app:noticeType="warning" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shareButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/menu_row_min_height"
        android:text="@string/social_share_experience"
        app:icon="@drawable/ic_add" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/social_my_posts_empty"
        android:textAppearance="@style/TextAppearance.SafeSphere.Body"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/postList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/showMoreButton"
        style="@style/Widget.SafeSphere.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/min_touch_target"
        android:text="@string/social_show_more"
        android:visibility="gone" />
</LinearLayout>
