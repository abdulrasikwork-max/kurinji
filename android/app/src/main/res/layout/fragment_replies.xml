<?xml version="1.0" encoding="utf-8"?>
<!-- Phase N5 (D19): Replies, a tab: what needs you, your plans, your private replies, who feels the same; then it ends.
     No number, no "seen", nothing about who opened anything. Read again each time the tab is shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/title_replies"
            android:textAppearance="@style/TextAppearance.Kurinji.Wordmark"
            android:textSize="26sp" />
    </LinearLayout>

    <com.safesphere.app.core.ui.components.NoticeView
        android:id="@+id/errorNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        app:noticeText="@string/error_unknown"
        app:noticeType="warning" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        style="@style/Widget.SafeSphere.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="@string/location_action_retry"
        android:visibility="gone" />

    <!-- 403 MEMBERSHIP_NEEDED: Replies are for verified MIET members. -->
    <LinearLayout
        android:id="@+id/membershipBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/replies_members_only"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getVerifiedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/action_get_verified" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_lg"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
