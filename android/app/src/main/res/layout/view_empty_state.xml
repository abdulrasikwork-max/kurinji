<?xml version="1.0" encoding="utf-8"?>
<!-- Children of EmptyStateView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/emptyIcon"
        style="@style/Widget.SafeSphere.IconCircle"
        android:layout_width="@dimen/icon_circle_size"
        android:layout_height="@dimen/icon_circle_size" />

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

    <TextView
        android:id="@+id/emptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SafeSphere.Body" />
</merge>
