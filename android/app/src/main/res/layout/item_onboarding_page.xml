<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl">

    <!-- Navy tile with a teal icon: the same brand language as Home and Login -->
    <FrameLayout
        android:layout_width="@dimen/illustration_size"
        android:layout_height="@dimen/illustration_size"
        android:background="@drawable/bg_brand_tile">

        <ImageView
            android:id="@+id/pageIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/colorHeroAccent" />
    </FrameLayout>

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle" />

    <TextView
        android:id="@+id/pageDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SafeSphere.Body" />
</LinearLayout>
