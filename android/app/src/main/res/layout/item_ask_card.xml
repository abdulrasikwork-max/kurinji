<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 13F (F13): an Ask as a question slip pinned to a board: dashed edge, a large question mark, the question,
     and where it is about. One TalkBack item. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:background="@drawable/bg_ask_slip"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/press_settle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="@string/card_ask_mark"
            android:textAppearance="@style/TextAppearance.Kurinji.Masthead"
            android:textColor="?attr/colorPrimary"
            android:textSize="40sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Kurinji.Overline" />

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="4"
                android:textAppearance="@style/TextAppearance.Kurinji.CardHeadline"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/collapsedLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                android:visibility="gone" />

            <TextView
                android:id="@+id/byline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/whyButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minWidth="0dp"
                android:text="@string/discover_why"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
