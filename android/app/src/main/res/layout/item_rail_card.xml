<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 16, restyled in 17E: one post in "Talking now": who (photo avatar), their words (3 lines), and how many
     comments the viewer can read, on a lime tag. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    style="@style/Widget.Kurinji.Card.Feed"
    android:layout_width="@dimen/rail_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.safesphere.app.core.ui.components.AvatarView
                android:id="@+id/avatar"
                android:layout_width="@dimen/avatar_size_small"
                android:layout_height="@dimen/avatar_size_small" />

            <TextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Kurinji.Name" />
        </LinearLayout>

        <TextView
            android:id="@+id/thought"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lines="3"
            android:textAppearance="@style/TextAppearance.Kurinji.CardHeadline" />

        <TextView
            android:id="@+id/comments"
            style="@style/Widget.Kurinji.Tag"
            android:layout_marginTop="12dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            app:drawableStartCompat="@drawable/ic_comment"
            app:drawableTint="?attr/colorOnLime" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>