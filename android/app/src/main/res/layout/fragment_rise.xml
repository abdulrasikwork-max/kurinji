<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 10B: the Rise tab. Shows nothing personal before the intro was seen and (if chosen) the screen lock confirmed. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:text="@string/rise_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/rise_tagline"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

        <ProgressBar
            android:id="@+id/riseProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg" />

        <!-- First use -->
        <LinearLayout
            android:id="@+id/introPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                tools:targetApi="p"
                android:text="@string/rise_intro_title"
                android:textAppearance="@style/TextAppearance.SafeSphere.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/rise_intro_body"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <com.safesphere.app.core.ui.components.NoticeView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:noticeText="@string/rise_intro_private"
                app:noticeType="info" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rise_intro_no_pressure"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/introLockSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:minHeight="48dp"
                android:text="@string/rise_lock_setting" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/introStartButton"
                style="@style/Widget.SafeSphere.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rise_intro_start" />
        </LinearLayout>

        <!-- Locked with the phone's screen lock -->
        <LinearLayout
            android:id="@+id/lockedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                tools:targetApi="p"
                android:text="@string/rise_locked_title"
                android:textAppearance="@style/TextAppearance.SafeSphere.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/rise_locked_body"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unlockButton"
                style="@style/Widget.SafeSphere.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rise_unlock" />
        </LinearLayout>

        <!-- The file could not be opened -->
        <LinearLayout
            android:id="@+id/unreadablePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <com.safesphere.app.core.ui.components.NoticeView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:noticeText="@string/rise_unreadable"
                app:noticeType="warning" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startFreshButton"
                style="@style/Widget.SafeSphere.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rise_start_fresh" />
        </LinearLayout>

        <!-- Goals, proof and settings -->
        <LinearLayout
            android:id="@+id/readyPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/rise_empty_title"
                android:textAppearance="@style/TextAppearance.SafeSphere.SectionTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newGoalButton"
                style="@style/Widget.SafeSphere.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rise_new_goal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/proofButton"
                style="@style/Widget.SafeSphere.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/rise_your_proof" />

            <com.safesphere.app.core.ui.components.SectionHeaderView
                android:id="@+id/goalsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                app:badgeStatus="none"
                app:sectionTitle="@string/rise_section_goals" />

            <LinearLayout
                android:id="@+id/goalsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.safesphere.app.core.ui.components.SectionHeaderView
                android:id="@+id/asideHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                app:badgeStatus="none"
                app:sectionTitle="@string/rise_section_aside" />

            <LinearLayout
                android:id="@+id/asideContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.safesphere.app.core.ui.components.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                app:badgeStatus="none"
                app:sectionTitle="@string/rise_settings_title" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/quietSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rise_quiet_mode" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rise_quiet_mode_hint"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/lockSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minHeight="48dp"
                android:text="@string/rise_lock_setting" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteAllButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/rise_delete_all" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
