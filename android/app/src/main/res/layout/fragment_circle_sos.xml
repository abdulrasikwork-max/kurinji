<?xml version="1.0" encoding="utf-8"?>
<!-- N7 (D36): an SOS of someone whose Safety Circle you joined. U4: the siren and the word SOS, black with a red ring. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sosCard"
            style="@style/Widget.SafeSphere.Card.Emergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:id="@+id/sosTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:drawablePadding="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle"
                    android:textColor="?attr/colorOnError"
                    app:drawableStartCompat="@drawable/ic_siren"
                    app:drawableTint="?attr/colorOnError" />

                <TextView
                    android:id="@+id/sosStarted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle"
                    android:textColor="?attr/colorOnError" />

                <TextView
                    android:id="@+id/sosStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                    android:textColor="?attr/colorOnError" />

                <TextView
                    android:id="@+id/sosLate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/circle_sos_late"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                    android:textColor="?attr/colorOnError"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/locationLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/circle_sos_open_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/callButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="@dimen/min_touch_target" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call112Button"
            style="@style/Widget.SafeSphere.Button.Emergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/circle_sos_call_112" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/circle_sos_note"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
    </LinearLayout>
</ScrollView>
