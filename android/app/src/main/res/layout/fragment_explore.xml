<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 17G-1: Explore. The words stay on the phone; the chips are what is searched (always visible, always editable). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <!-- R3: Explore is a tab now, so it carries its own title. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityHeading="true"
            android:text="@string/explore_title"
            android:textAppearance="@style/TextAppearance.Kurinji.ScreenTitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/explore_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/exploreInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences|textNoSuggestions"
                android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/exploreHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/explore_helper"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <!-- Phase 17G-3: the OPTIONAL smart understanding. Shown only when the server offers it; off until this account agrees. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/exploreSmartSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/explore_smart_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/exploreSmartSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/explore_smart_summary"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
            android:visibility="gone" />

        <TextView
            android:id="@+id/exploreSmartNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
            android:visibility="gone" />

        <TextView
            android:id="@+id/exploreUnused"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exploreCityButton"
            style="@style/Widget.Kurinji.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/explore_city_pick" />

        <TextView
            android:id="@+id/exploreCategoriesTitle"
            style="@style/SocialSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/explore_section_categories" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/exploreCategoryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/exploreFacetsTitle"
            style="@style/SocialSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/explore_section_facets" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/exploreFacetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/exploreDaypartTitle"
            style="@style/SocialSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/explore_section_daypart" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/exploreDaypartGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/exploreSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exploreSearchButton"
                style="@style/Widget.SafeSphere.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/explore_search" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exploreClearButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/explore_clear" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/exploreProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:contentDescription="@string/explore_loading"
            android:visibility="gone" />

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/exploreNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <TextView
            android:id="@+id/exploreResultsHeader"
            style="@style/SocialSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/explore_results_header"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/exploreResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/exploreEmptyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/explore_empty_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/exploreEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/explore_empty_message"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/exploreEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/explore_end"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/explore_footer"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
