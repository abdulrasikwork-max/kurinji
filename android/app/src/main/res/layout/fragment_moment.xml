<?xml version="1.0" encoding="utf-8"?>
<!-- Phase N4: one moment on its own page: the same card as on Today, in full, and under it what its author can do with
     it (keep it on the profile, un-keep, delete; no editing). A moment that is gone, ended or not for this reader says
     so in one calm line. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/errorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/location_action_retry"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/goneBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brand_mark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/moment_gone_title"
                android:textAppearance="@style/TextAppearance.Kurinji.Headline.Small" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/moment_gone_message"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />
        </LinearLayout>

        <include
            android:id="@+id/momentCard"
            layout="@layout/item_moment_card"
            android:visibility="gone" />

        <!-- N5: responses. Same / Say more on a Say, I'm in on a Who's in? (only while it is on Today, never on one's
             own); where the reader stands in a plan, never "declined"; the author's names and tools. No number. -->
        <LinearLayout
            android:id="@+id/responseBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_sm"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/signalRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sameButton"
                    style="@style/Widget.Kurinji.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/response_action_same" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sayMoreButton"
                    style="@style/Widget.Kurinji.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/response_action_say_more" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inButton"
                style="@style/Widget.Kurinji.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/response_action_in" />

            <TextView
                android:id="@+id/standingLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Kurinji.Title.Medium" />

            <TextView
                android:id="@+id/responseLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingMultiplier="1.15"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/withdrawButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/response_action_take_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addMoreButton"
                style="@style/Widget.Kurinji.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/response_action_add_more" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/peopleButton"
                    style="@style/Widget.SafeSphere.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/response_action_people"
                    app:icon="@drawable/ic_group" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/callOffButton"
                    style="@style/Widget.SafeSphere.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/response_action_call_off" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ownBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/lifeLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

            <!-- A3: the author asks a person to look (a rule covered or held it), or for a review of a moderator's decision -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkReviewButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/check_review_ask"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appealButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/review_ask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/reviewLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keepButton"
                style="@style/Widget.SafeSphere.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/moment_action_keep" />

            <TextView
                android:id="@+id/keepHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/moment_keep_hint"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/moment_action_delete" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/authorButton"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:visibility="gone" />

        <!-- A3: someone else's moment: report it, or say it is about you (it is hidden until a moderator looks) -->
        <LinearLayout
            android:id="@+id/othersBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/screen_padding"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/moment_report" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aboutMeButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/moment_about_me" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
