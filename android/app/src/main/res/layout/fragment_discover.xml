<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 16, redesigned in 17E ("Ink & Lime"): Discover as one social feed. A head with the wordmark and search, then the
     city as the big title ("Discover · Chennai ⌄", tap to choose any of the catalog's cities in a sheet; not saved),
     then one list: Near me + categories, "Talking now", the city's posts with questions mixed in, the theme of the week,
     posts from people you know, and an end. Search and "Near me" open a panel over the feed; the feed keeps its place
     underneath. The head and the city title scroll away with the feed and come back on the first scroll up (found on a
     320 dp screen at 2.0x text, where a fixed head took a third of the screen). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/discoverHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:stateListAnimator="@null"
        app:liftOnScroll="false"
        app:liftOnScrollColor="?android:attr/colorBackground">

    <!-- Head -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="12dp"
        app:layout_scrollFlags="scroll|enterAlways">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Kurinji.Wordmark"
            android:textSize="22sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchToggle"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:contentDescription="@string/discover_search_open"
            app:backgroundTint="?attr/colorSurfaceContainerHigh"
            app:icon="@drawable/ic_search"
            app:iconTint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- The city is the title: "Discover" above, "Chennai ⌄" in big letters. -->
    <LinearLayout
        android:id="@+id/cityButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        app:layout_scrollFlags="scroll|enterAlways">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/discover_title"
            android:textAppearance="@style/TextAppearance.Kurinji.Label.Medium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/cityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/discover_masthead_no_city"
            android:textAppearance="@style/TextAppearance.Kurinji.ScreenTitle"
            app:drawableEndCompat="@drawable/ic_chevron_down"
            app:drawableTint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Phase 17G-1: Explore opens its own screen (the search icon above still finds place and category names). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/exploreButton"
        style="@style/Widget.Kurinji.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_xs"
        android:contentDescription="@string/explore_entry_description"
        android:minHeight="@dimen/min_touch_target"
        android:text="@string/explore_entry"
        app:icon="@drawable/ic_search"
        app:layout_scrollFlags="scroll|enterAlways" />

    <com.safesphere.app.core.ui.components.NoticeView
        android:id="@+id/errorNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_xs"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        app:noticeText="@string/error_unknown"
        app:noticeType="warning" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        style="@style/Widget.SafeSphere.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="@string/location_action_retry"
        android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/feed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_lg"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Search and "Near me": a panel over the feed. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:id="@+id/searchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/discover_search_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/searchInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:maxLength="60" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/searchButton"
                            style="@style/Widget.SafeSphere.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/discover_search_button" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearSearchButton"
                        style="@style/Widget.SafeSphere.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discover_search_clear"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/searchBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/searchCategoriesTitle"
                            style="@style/SocialSectionTitle"
                            android:text="@string/discover_search_categories" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/searchCategoryList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                        <TextView
                            style="@style/SocialSectionTitle"
                            android:text="@string/discover_search_places" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/searchPlaceList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                        <TextView
                            android:id="@+id/searchNoPlaces"
                            style="@style/SocialEmptyLine"
                            android:text="@string/discover_search_no_places" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Phase 16: places around the person's ~1 km area (one fix; only the area is sent). -->
                <LinearLayout
                    android:id="@+id/nearPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/discover_near_title"
                            android:textAppearance="@style/TextAppearance.SafeSphere.SectionTitle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/closeNearButton"
                            style="@style/Widget.SafeSphere.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_close" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/discover_near_note"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/nearProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <com.safesphere.app.core.ui.components.NoticeView
                        android:id="@+id/nearNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:accessibilityLiveRegion="polite"
                        android:visibility="gone"
                        app:noticeText="@string/social_location_needed"
                        app:noticeType="info" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nearActionButton"
                        style="@style/Widget.SafeSphere.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/nearList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <TextView
                        android:id="@+id/nearEmpty"
                        style="@style/SocialEmptyLine"
                        android:text="@string/discover_near_empty" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
