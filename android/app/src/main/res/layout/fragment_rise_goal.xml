<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 10B: one goal and its steps, in the person's own order. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/goalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:textAppearance="@style/TextAppearance.SafeSphere.SectionTitle" />

        <TextView
            android:id="@+id/goalDomain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <TextView
            android:id="@+id/goalSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/stepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/asideButton"
            style="@style/Widget.SafeSphere.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteGoalButton"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/rise_goal_delete" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
