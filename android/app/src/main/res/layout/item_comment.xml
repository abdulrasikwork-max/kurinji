<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 16: one comment: who, what kind and when, the words, notes (helped, hidden, waiting), then Reply and More.
     A reply sits indented under its comment. The words and the line above them are one TalkBack item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="12dp">

    <com.safesphere.app.core.ui.components.AvatarView
        android:id="@+id/avatar"
        android:layout_width="@dimen/avatar_size_small"
        android:layout_height="@dimen/avatar_size_small" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/readable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.Kurinji.Name"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.Kurinji.Body.Medium"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/replyButton"
                style="@style/Widget.Kurinji.Button.Small"
                android:text="@string/social_reply"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/moreButton"
                style="@style/Widget.Kurinji.Button.Small"
                android:text="@string/action_more"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>