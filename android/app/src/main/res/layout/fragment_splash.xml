<?xml version="1.0" encoding="utf-8"?>
<!-- IRL opening screen (2026-11-03, docs/DESIGN_SYSTEM.md "Opening"). Always ink, continuing the launch screen:
     the IRL lockup, "the Meet" rising as the hero, then "OUT THERE. TOGETHER.", "YOUR WORLD. / YOUR PEOPLE. /
     YOUR FREEDOM.", the supporting line and "LET'S GO →". The button appears only on the first run (it leads to the
     onboarding); a returning person is taken on by themselves after the short launch time (SplashFragment), so the
     opening never slows the way to SOS. The button is pinned to the bottom, always in view; the words above it scroll
     when large text needs the room, and the hero hides on tight screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
    
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="8dp">
    
            <!-- The lockup: the mark, IRL, and what it stands for. -->
            <LinearLayout
                android:id="@+id/openingBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_app_logo"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
    
                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mark_on_ink" />
    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Kurinji.Wordmark"
                    android:textColor="@color/launcher_white"
                    android:textSize="26sp" />
    
                <TextView
                    style="@style/Opening.Eyebrow"
                    android:layout_marginStart="10dp"
                    android:importantForAccessibility="no"
                    android:text="@string/opening_expansion"
                    android:textColor="@color/opening_soft"
                    android:textSize="11sp" />
            </LinearLayout>
    
            <!-- Room on tall screens: the hero sits right above the words, rising from them. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="12dp" />
    
            <ImageView
                android:id="@+id/openingArt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxHeight="300dp"
                android:scaleType="fitCenter"
                android:src="@drawable/art_opening_meet" />
    
            <TextView
                android:id="@+id/openingMotto"
                style="@style/Opening.Eyebrow"
                android:layout_marginTop="28dp"
                android:text="@string/motto" />
    
            <LinearLayout
                android:id="@+id/openingHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/opening_headline_spoken"
                android:focusable="true"
                android:orientation="vertical">
    
                <TextView
                    android:id="@+id/openingLineWorld"
                    style="@style/Opening.Headline"
                    android:text="@string/opening_line_world" />
    
                <TextView
                    android:id="@+id/openingLinePeople"
                    style="@style/Opening.Headline"
                    android:layout_marginTop="@dimen/opening_headline_overlap"
                    android:text="@string/opening_line_people" />
    
                <TextView
                    android:id="@+id/openingLineFreedom"
                    style="@style/Opening.Headline"
                    android:layout_marginTop="@dimen/opening_headline_overlap"
                    android:text="@string/opening_line_freedom"
                    android:textColor="@color/launcher_lime" />
            </LinearLayout>
    
            <TextView
                android:id="@+id/openingSupporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/opening_supporting"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                android:textColor="@color/opening_soft"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Pinned: always in view on the first run; invisible (its room kept, nothing jumps) for a returning person. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/openingStart"
        style="@style/Widget.IRL.Button.Opening"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/opening_cta_description"
        android:text="@string/opening_cta"
        android:visibility="invisible" />
</LinearLayout>
