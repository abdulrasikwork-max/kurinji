<?xml version="1.0" encoding="utf-8"?>
<!-- Phase N4: one moment on Today, on a profile or on its own page. Who said it (photo or initial, real name) and
     roughly when; "Who's in?" as a tag when it is a plan; the daily question it answers; their words, large; the photo
     (rounded, laid out before it arrives); the plan (time exactly as written, and where, in their words) on a quiet
     panel with the accent rule. No count of anything, no place, nobody who looked. A moment a rule or reports covered
     is shown behind a tap; the author's own moment says its state in plain words (amber, never red). The whole card
     is one TalkBack item (MomentCardBinder.spoken). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/Widget.Kurinji.Card.Feed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_md"
    android:layout_marginEnd="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.safesphere.app.core.ui.components.AvatarView
                android:id="@+id/avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Kurinji.Name"
                    tools:text="Asha Krishnan" />

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                    tools:text="This morning · My people" />
            </LinearLayout>

            <TextView
                android:id="@+id/kindTag"
                style="@style/Widget.Kurinji.Tag"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/moment_kind_whos_in"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Kurinji.Overline"
            android:textColor="?attr/colorAccentText"
            android:visibility="gone"
            tools:text="TODAY'S QUESTION · What made you smile?"
            tools:visibility="visible" />

        <!-- Covered by a rule or by reports: the words and the photo wait behind this line. -->
        <TextView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tip"
            android:minHeight="@dimen/min_touch_target"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/moment_cover"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.12"
                android:textAppearance="@style/TextAppearance.Kurinji.Body.Large"
                android:textColor="?attr/colorOnSurface"
                tools:text="Canteen coffee is back and it is actually good." />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/photoFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <com.safesphere.app.core.ui.components.AspectRatioImageView
                    android:id="@+id/photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_quote_rule"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/planTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Kurinji.Title.Medium"
                    tools:text="Today, 5:30 pm" />

                <TextView
                    android:id="@+id/planWhere"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                    tools:text="Canteen, near the banyan tree" />
            </LinearLayout>
        </LinearLayout>

        <!-- The author's own moment: its state, in words. -->
        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:noticeText="@string/moment_notice_held"
            app:noticeType="warning" />

        <TextView
            android:id="@+id/keptLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/moment_kept_line"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
