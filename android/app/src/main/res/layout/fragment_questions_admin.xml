<?xml version="1.0" encoding="utf-8"?>
<!-- Phase N4 (A3): admins schedule the daily question (one per India day, today to 60 days ahead) and delete one.
     No editing. The list shows what is scheduled; nothing is counted. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/statusNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <LinearLayout
            android:id="@+id/formBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/questions_admin_intro"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayButton"
                style="@style/Widget.SafeSphere.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/questions_admin_choose_day" />

            <TextView
                android:id="@+id/dayTaken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/questions_admin_day_taken"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textLayout"
                style="@style/Widget.SafeSphere.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/questions_admin_text_label"
                app:helperText="@string/questions_admin_text_help">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="140"
                    android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scheduleButton"
                style="@style/Widget.SafeSphere.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:enabled="false"
                android:text="@string/questions_admin_schedule" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:accessibilityHeading="true"
                android:text="@string/questions_admin_list_title"
                android:textAppearance="@style/TextAppearance.Kurinji.Overline"
                android:textColor="?attr/colorAccentText" />

            <TextView
                android:id="@+id/emptyLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/questions_admin_empty"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/questionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
