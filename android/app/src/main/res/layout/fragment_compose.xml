<?xml version="1.0" encoding="utf-8"?>
<!-- IRL redesign (R2): Share, made short. The photos or video first, then a few words, then (optionally) a place and who
     sees it, then Share. Everything else (a tip, when, "good for", category, who can comment) is under "Add details",
     closed until asked for, with working defaults. The place starts as the profile's city (or no place), so nothing but
     the words and the audience (asked once, then remembered) is needed. Choice chips are added in code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- 1. Photos or a video -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photoList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addPhotosButton"
            style="@style/Widget.Kurinji.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:text="@string/compose_add_media"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart" />

        <!-- 2. The words -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/bodyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/social_body_label_experience">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bodyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/questionChip"
            style="@style/Widget.Kurinji.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:checkable="true"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/compose_question_chip" />

        <!-- 3. Where (optional): one row; the place picker is one tap away. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/choosePlaceButton"
            style="@style/Widget.SafeSphere.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="start|center_vertical"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/compose_place_add"
            app:icon="@drawable/ic_place"
            app:iconTint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/precisionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/social_precision_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/precisionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true" />

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/privateNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone"
            app:noticeText="@string/social_precision_private_notice"
            app:noticeType="info" />

        <TextView
            android:id="@+id/cityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/social_city_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

        <!-- Phase 17E (D-5): any catalog city or "Another city", from the city picker (searched on the phone). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cityButton"
            style="@style/Widget.SafeSphere.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="start|center_vertical"
            android:text="@string/city_picker_title"
            app:icon="@drawable/ic_city"
            app:iconTint="?attr/colorOnSurface" />

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/delayNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone"
            app:noticeText="@string/social_delay_notice"
            app:noticeType="info" />

        <!-- What others will see of the place, in words. -->
        <TextView
            android:id="@+id/summaryLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <!-- 4. Who sees it: asked the first time, remembered afterwards. -->
        <TextView
            style="@style/SocialSectionTitle"
            android:text="@string/social_audience_title" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/audienceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/audienceLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

        <!-- 5. Everything optional, closed until asked for. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailsToggle"
            style="@style/Widget.SafeSphere.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/compose_details_show"
            app:icon="@drawable/ic_tune" />

        <LinearLayout
            android:id="@+id/detailsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tipLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/social_tip_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tipInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/whenTitle"
                style="@style/SocialSectionTitle"
                android:text="@string/social_when_title" />

            <Spinner
                android:id="@+id/monthSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/social_daypart_title"
                android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/daypartGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true" />

            <!-- Phase 17G-1: optional Explore tags, an Experience only (hidden for a question). -->
            <TextView
                android:id="@+id/facetsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/social_facets_title"
                android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/facetGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/facetsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/social_facets_note"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

            <TextView
                style="@style/SocialSectionTitle"
                android:text="@string/social_category_title" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoryGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/commentsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/social_comments_title"
                android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/commentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true" />

            <!-- Phase 13D (Q6): only with "Anyone who can see it". -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/approveFirstSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/approve_first_switch"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/social_photos_note"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/issuesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle"
            android:visibility="gone" />

        <!-- Phase 17A: next to the Share button, where the person is when sharing fails. -->
        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/errorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/makeProfileButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/menu_row_min_height"
            android:text="@string/compose_make_profile"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="@dimen/menu_row_min_height" />
    </LinearLayout>
</ScrollView>
