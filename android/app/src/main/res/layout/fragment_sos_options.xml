<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            tools:ignore="UnusedAttribute"
            android:text="@string/sos_options_title"
            android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/sos_options_subtitle"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

        <!-- Shake -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/shakeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/sos_options_shake_title"
                    android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/sos_options_shake_body"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

                <TextView
                    android:id="@+id/shakeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shakeNotificationsButton"
                    style="@style/Widget.SafeSphere.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/sos_options_shake_notifications_action"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Audio -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/audioSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/sos_options_audio_title"
                    android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/sos_options_audio_body"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

                <TextView
                    android:id="@+id/audioStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audioPermissionButton"
                    style="@style/Widget.SafeSphere.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Voice: said plainly, not hidden -->
        <com.safesphere.app.core.ui.components.NoticeView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:noticeText="@string/sos_options_voice_notice"
            app:noticeType="info" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
