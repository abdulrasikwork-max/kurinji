<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 13A, redesigned in 17E: someone's profile on the ink panel (photo in a lime ring, name, handle, how you are
     connected, today's state for connections only, bio, city, languages, interests). No counts, no presence, no
     messages. -->
<!-- Found on a real phone (A23, live path): the posts used to sit in a non-scrolling RecyclerView inside this
     ScrollView, which lays out only about one screen of items, so a second photo post was unreachable. Now, as on
     Discover, the profile (everything above the posts) is an AppBarLayout header that scrolls away with the list, and
     the posts are a self-scrolling RecyclerView; "Show more" and the progress bar stay in place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_sm"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:stateListAnimator="@null"
            app:liftOnScroll="false"
            app:liftOnScrollColor="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        app:layout_scrollFlags="scroll">

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/errorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <!-- Unknown handle, or someone the viewer may not see: the same screen, on purpose. -->
        <com.safesphere.app.core.ui.components.EmptyStateView
            android:id="@+id/notFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            app:emptyIcon="@drawable/ic_person_outline"
            app:emptyMessage="@string/social_not_found_message"
            app:emptyTitle="@string/social_not_found_title" />

        <LinearLayout
            android:id="@+id/contentBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kurinji.Card.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_ring_lime"
                        android:importantForAccessibility="noHideDescendants"
                        android:padding="5dp">

                        <com.safesphere.app.core.ui.components.AvatarView
                            android:id="@+id/avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/displayName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.Kurinji.Headline.Large"
                        android:textColor="?attr/colorOnPanel" />

                    <TextView
                        android:id="@+id/handle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                        android:textColor="?attr/colorOnPanelVariant" />

                    <TextView
                        android:id="@+id/relationship"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.SafeSphere.CardTitle"
                        android:textColor="?attr/colorLime" />

                    <!-- Phase 17E (D-7): today's state, only when the viewer is a connection. -->
                    <TextView
                        android:id="@+id/dailyState"
                        style="@style/Widget.Kurinji.Tag"
                        android:layout_marginTop="@dimen/space_sm"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:visibility="gone"
                        app:drawableTint="?attr/colorOnLime" />

                    <TextView
                        android:id="@+id/bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:textAppearance="@style/TextAppearance.Kurinji.Body.Large"
                        android:textColor="?attr/colorOnPanel" />

                    <TextView
                        android:id="@+id/city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                        android:textColor="?attr/colorOnPanelVariant" />

                    <TextView
                        android:id="@+id/languages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                        android:textColor="?attr/colorOnPanelVariant" />

                    <TextView
                        android:id="@+id/interests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                        android:textColor="?attr/colorOnPanelVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:minHeight="@dimen/menu_row_min_height" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/removeButton"
                style="@style/Widget.SafeSphere.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minHeight="@dimen/menu_row_min_height"
                android:text="@string/social_remove_connection" />

            <LinearLayout
                android:id="@+id/moreActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="start"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/muteButton"
                    style="@style/Widget.SafeSphere.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/social_mute" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/blockButton"
                    style="@style/Widget.SafeSphere.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/social_block" />
            </LinearLayout>

            <!-- Phase 13D: report the person (behaviour, impersonation); nobody is told who reported. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportPersonButton"
                style="@style/Widget.SafeSphere.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/report_person"
                android:visibility="gone" />

            <!-- Phase 13B: the experiences of this person the viewer may see -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareExperienceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:minHeight="@dimen/menu_row_min_height"
                android:text="@string/social_share_experience"
                android:visibility="gone"
                app:icon="@drawable/ic_add" />

            <TextView
                style="@style/SocialSectionTitle"
                android:text="@string/social_experiences_title" />

            <TextView
                android:id="@+id/postsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/social_experiences_empty"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/postList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/showMoreButton"
        style="@style/Widget.SafeSphere.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/space_sm"
        android:minHeight="@dimen/min_touch_target"
        android:text="@string/social_show_more"
        android:visibility="gone" />
</LinearLayout>
