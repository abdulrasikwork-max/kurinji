<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 17E: one tile of the compact Safety grid on You (Safe Walk, Safety Circle, Nearby): icon, name, one line.
     It only opens the existing Safety screen. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile"
    style="@style/Widget.Kurinji.Card.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:minHeight="112dp"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tag_lime"
            android:importantForAccessibility="no"
            android:padding="9dp"
            app:tint="?attr/colorOnLime" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.Kurinji.Title.Medium" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
