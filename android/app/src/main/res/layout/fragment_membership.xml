<?xml version="1.0" encoding="utf-8"?>
<!-- Phase N3 (A1): the MIET community membership: get verified (ONE way: in person, or an ID photo), the in-person code,
     the request, and the person's own state. Task screen: toolbar + back. FLAG_SECURE (code, roll number). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- A refusal, an end or a ban, told to the person it is about (no shadow decisions); amber, never red -->
        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/outcomeNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/membership_safety_unchanged"
            app:noticeType="warning" />

        <!-- MEMBER -->
        <LinearLayout
            android:id="@+id/memberBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/memberLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle" />

            <TextView
                android:id="@+id/memberDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <TextView
                android:id="@+id/memberUntil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />
        </LinearLayout>

        <!-- Owner's item 8: a corrected spelling is shown to the person; N-24: the name is locked -->
        <TextView
            android:id="@+id/nameCorrectionLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nameLockedLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/membership_name_locked"
            android:textAppearance="@style/TextAppearance.SafeSphere.Body"
            android:visibility="gone" />

        <!-- NONE / ENDED: the form -->
        <LinearLayout
            android:id="@+id/formBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/membership_form_title"
                android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/membership_intro"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:accessibilityHeading="true"
                android:text="@string/membership_choose_way"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <RadioGroup
                android:id="@+id/methodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:checkedButton="@+id/inPersonOption">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/inPersonOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/menu_row_min_height"
                    android:text="@string/membership_way_in_person" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/idPhotoOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/menu_row_min_height"
                    android:text="@string/membership_way_photo" />
            </RadioGroup>

            <TextView
                android:id="@+id/methodDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/membership_way_in_person_detail"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/rollLayout"
                style="@style/Widget.SafeSphere.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:hint="@string/membership_roll_label"
                app:helperText="@string/membership_roll_helper"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rollInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                    android:maxLength="24"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tapping opens the owner's list of 14 programmes -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/programmeLayout"
                style="@style/Widget.SafeSphere.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/membership_programme_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/programmeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:importantForAutofill="no"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/yearLayout"
                style="@style/Widget.SafeSphere.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/membership_year_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/yearInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/membership_roll_privacy"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/askButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:minHeight="@dimen/menu_row_min_height"
                android:text="@string/membership_ask" />
        </LinearLayout>

        <!-- PENDING -->
        <LinearLayout
            android:id="@+id/pendingBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/pendingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle" />

            <TextView
                android:id="@+id/pendingDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <!-- The in-person code, large and spaced, so a verifier can read it from the screen -->
            <TextView
                android:id="@+id/codeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textAppearance="@style/TextAppearance.SafeSphere.ScreenTitle"
                android:textIsSelectable="false"
                android:textSize="36sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/codeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newCodeButton"
                style="@style/Widget.SafeSphere.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/membership_new_code"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:minHeight="@dimen/menu_row_min_height"
                android:text="@string/membership_take_photo"
                android:visibility="gone" />

            <TextView
                android:id="@+id/requestUntil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/withdrawButton"
                style="@style/Widget.SafeSphere.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/membership_withdraw" />
        </LinearLayout>

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/errorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.SafeSphere.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/action_retry"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
