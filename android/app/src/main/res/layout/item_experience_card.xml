<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 16: one post in a feed, read in a second: who (avatar, name, kind, when), the photo, their own words, where,
     then the actions: save (the butterfly), comments (the one public number, U1), and "Why?" for Discover picks.
     Experiences and Questions share this card; a Question carries a badge. The card body is one TalkBack item
     (CardTexts.spoken); the save and comment buttons are their own items. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    style="@style/Widget.Kurinji.Card.Feed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The readable part: one click target, one spoken sentence. -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="14dp"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="12dp">

                <com.safesphere.app.core.ui.components.AvatarView
                    android:id="@+id/avatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Kurinji.Name" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/questionBadge"
                    style="@style/Widget.Kurinji.Badge"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/feed_question_badge"
                    android:visibility="gone" />
            </LinearLayout>

            <com.safesphere.app.core.ui.components.AspectRatioImageView
                android:id="@+id/photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/space_md">

                <TextView
                    android:id="@+id/thought"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="4"
                    android:textAppearance="@style/TextAppearance.Kurinji.CardHeadline" />

                <!-- Collapsed (13D/13E): only the reason; the words stay behind a tap on the post. -->
                <TextView
                    android:id="@+id/collapsedLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_info"
                    app:drawableTint="?attr/colorOnSurfaceVariant" />

                <!-- Where (only what the author revealed) and whether there is a tip inside. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/contextChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions: save, comments, and "Why?" on Discover picks. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/Widget.Kurinji.Button.Action"
                android:text="@string/butterfly_want"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/commentButton"
                style="@style/Widget.Kurinji.Button.Action"
                android:text="@string/feed_comment"
                app:icon="@drawable/ic_comment" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/whyButton"
                style="@style/Widget.Kurinji.Button.Action"
                android:contentDescription="@string/discover_why_title"
                android:text="@string/discover_why"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
