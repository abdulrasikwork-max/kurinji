<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 17E ("Ink & Lime"): one post in a feed. The place comes first: the photo (inset, rounded) with the category on
     a lime tag; then who shared it (photo avatar, name, when) and "Why?" for Discover picks; their own words (a quote
     panel with a lime rule when there is no photo); where and "Tip inside"; then the marks: the butterfly (a
     reaction), comments (the one public number, U1) and Save. The readable part is one TalkBack item
     (CardTexts.spoken); each mark is its own item and says its state in words. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/Widget.Kurinji.Card.Feed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The readable part: one click target, one spoken sentence. -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/photoFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="noHideDescendants"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <com.safesphere.app.core.ui.components.AspectRatioImageView
                    android:id="@+id/photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/categoryTag"
                    style="@style/Widget.Kurinji.Tag"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:visibility="gone"
                    tools:text="Food &amp; cafés"
                    tools:visibility="visible" />

                <!-- Phase 17C: a video's still carries "▶ 0:42"; the card opens the post (nothing plays here). -->
                <TextView
                    android:id="@+id/videoBadge"
                    style="@style/Widget.Kurinji.VideoBadge"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="10dp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_play" />

                <!-- More than one photo or video: "1 / 3" so people know there is more inside. -->
                <TextView
                    android:id="@+id/mediaCount"
                    style="@style/Widget.Kurinji.VideoBadge"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone"
                    tools:text="1 / 3"
                    tools:visibility="visible" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="12dp"
                android:paddingEnd="6dp">

                <com.safesphere.app.core.ui.components.AvatarView
                    android:id="@+id/avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Kurinji.Name"
                        tools:text="Meena" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                        tools:text="This week" />
                </LinearLayout>

                <TextView
                    android:id="@+id/questionBadge"
                    style="@style/Widget.Kurinji.Badge"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_marginEnd="10dp"
                    android:text="@string/feed_question_badge"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/thought"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/space_md"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="4"
                android:textAppearance="@style/TextAppearance.Kurinji.CardHeadline"
                tools:text="Went at sunrise; the light on the water was lovely and the tea stall had opened." />

            <!-- No photo: the words are the picture (a quote panel with a lime rule). -->
            <TextView
                android:id="@+id/quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_quote_rule"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="6"
                android:paddingStart="30dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp"
                android:textAppearance="@style/TextAppearance.Kurinji.Quote"
                android:visibility="gone" />

            <!-- Collapsed (13D/13E): only the reason; the words stay behind a tap on the post. -->
            <TextView
                android:id="@+id/collapsedLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/space_md"
                android:drawablePadding="@dimen/space_sm"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

            <!-- Where (only what the author revealed) and whether there is a tip inside. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/contextChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/space_md"
                android:importantForAccessibility="noHideDescendants"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp" />
        </LinearLayout>

        <!-- The marks: the butterfly (a reaction), comments, Why? and Save. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reactButton"
                style="@style/Widget.Kurinji.Button.Mark"
                android:text="@string/reaction_label"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/commentButton"
                style="@style/Widget.Kurinji.Button.Mark"
                android:text="@string/feed_comment"
                app:icon="@drawable/ic_comment" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/Widget.Kurinji.Button.Mark"
                android:text="@string/save_label"
                android:visibility="gone"
                app:icon="@drawable/ic_bookmark" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
