<?xml version="1.0" encoding="utf-8"?>
<!-- Phase N4 (A2): Create. Opens ready to type: the words first, large, on the page itself (no box around them); under
     them the photo (taken now with the camera app), the plan of a Who's in?, and who can see it. One Share button.
     Screenshots are allowed here (D12: only one's own words). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.safesphere.app.core.ui.components.NoticeView
            android:id="@+id/errorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:noticeText="@string/error_unknown"
            app:noticeType="warning" />

        <LinearLayout
            android:id="@+id/membershipBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_md"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_members_only"
                android:textAppearance="@style/TextAppearance.SafeSphere.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/getVerifiedButton"
                style="@style/Widget.SafeSphere.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/action_get_verified" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/draftBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Today's question, when this moment answers it -->
            <LinearLayout
                android:id="@+id/questionBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_quote_rule"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/create_question_label"
                        android:textAppearance="@style/TextAppearance.Kurinji.Overline"
                        android:textColor="?attr/colorAccentText" />

                    <TextView
                        android:id="@+id/questionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.Kurinji.Title.Medium"
                        tools:text="What made you smile on campus today?" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/removeQuestionButton"
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/create_question_remove"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- N5 (N-92): This happened, from a plan: a photo taken now, shared with the plan's audience -->
            <LinearLayout
                android:id="@+id/happenedBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_quote_rule"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_happened_label"
                    android:textAppearance="@style/TextAppearance.Kurinji.Overline"
                    android:textColor="?attr/colorAccentText" />

                <TextView
                    android:id="@+id/happenedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Kurinji.Title.Medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/create_happened_help"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/kindToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kindSay"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/create_kind_say" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kindWhosIn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/moment_kind_whos_in" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <EditText
                android:id="@+id/textInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/create_hint_say"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.12"
                android:minLines="4"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Kurinji.Headline.Small"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/roomLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                android:visibility="gone"
                tools:text="40 left"
                tools:visibility="visible" />

            <!-- The photo: the phone's own prepared copy (memory only) -->
            <LinearLayout
                android:id="@+id/photoBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <com.safesphere.app.core.ui.components.AspectRatioImageView
                        android:id="@+id/photoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cd_create_photo"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/photoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                    tools:text="Adding the photo…" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retryPhotoButton"
                        style="@style/Widget.SafeSphere.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/location_action_retry"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removePhotoButton"
                        style="@style/Widget.SafeSphere.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_photo_remove" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/photoPreparing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:accessibilityLiveRegion="polite"
                android:text="@string/create_photo_preparing"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/takePhotoButton"
                style="@style/Widget.SafeSphere.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/create_photo_take"
                app:icon="@drawable/ic_camera" />

            <!-- The plan of a Who's in?: an optional time (within 24 hours) and an optional "where" in plain words -->
            <LinearLayout
                android:id="@+id/planBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_quote_rule"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_plan_help"
                    android:textAppearance="@style/TextAppearance.SafeSphere.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/planTimeButton"
                        style="@style/Widget.SafeSphere.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:text="@string/create_plan_time_add" />

                    <ImageButton
                        android:id="@+id/clearPlanTimeButton"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="@dimen/min_touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/create_plan_time_clear"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/whereLayout"
                    style="@style/Widget.SafeSphere.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:hint="@string/create_plan_where_label"
                    app:helperText="@string/create_plan_where_help">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/whereInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLength="60"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:accessibilityHeading="true"
                android:text="@string/create_audience_label"
                android:textAppearance="@style/TextAppearance.Kurinji.Overline"
                android:textColor="?attr/colorAccentText" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/audienceToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audienceAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/create_audience_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audienceMine"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/moment_audience_my_people" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/audienceHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.SafeSphere.Caption"
                tools:text="@string/create_audience_needed" />

            <com.safesphere.app.core.ui.components.NoticeView
                android:id="@+id/newMemberNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                app:noticeText="@string/create_photo_preparing"
                app:noticeType="info"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                style="@style/Widget.SafeSphere.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:enabled="false"
                android:text="@string/create_share" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
