<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Kurinji type (Phase 16): Mukta Malar throughout, Bold (kurinji_display) for headlines, buttons and the wordmark,
        set large and tight; drawn for Tamil and Latin together. Sizes in sp, so the phone's font size applies.
        The TextAppearance.SafeSphere.* names stay (every layout uses them); they point at the Kurinji styles.
    -->

    <!-- ===== Display and headlines (Mukta Malar Bold) ===== -->
    <style name="TextAppearance.Kurinji.Masthead" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/kurinji_display</item>
        <item name="fontFamily">@font/kurinji_display</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Kurinji.Headline.Large" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/kurinji_display</item>
        <item name="fontFamily">@font/kurinji_display</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>

    <style name="TextAppearance.Kurinji.Headline.Medium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/kurinji_display</item>
        <item name="fontFamily">@font/kurinji_display</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Kurinji.Headline.Small" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/kurinji_display</item>
        <item name="fontFamily">@font/kurinji_display</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <!-- Phase 16: the short thought on a feed card (the post's own words, the first lines). -->
    <style name="TextAppearance.Kurinji.CardHeadline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/kurinji_sans_medium</item>
        <item name="fontFamily">@font/kurinji_sans_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Phase 16: a person's name on a card or comment. -->
    <style name="TextAppearance.Kurinji.Name" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/kurinji_display</item>
        <item name="fontFamily">@font/kurinji_display</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Phase 16: the wordmark "kurinji" (top bar, splash). -->
    <style name="TextAppearance.Kurinji.Wordmark" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/kurinji_display</item>
        <item name="fontFamily">@font/kurinji_display</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- ===== Material slots (Mukta Malar) ===== -->
    <style name="TextAppearance.Kurinji.Title.Large" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/kurinji_sans_medium</item>
        <item name="fontFamily">@font/kurinji_sans_medium</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Kurinji.Title.Medium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/kurinji_sans_medium</item>
        <item name="fontFamily">@font/kurinji_sans_medium</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Kurinji.Title.Small" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/kurinji_sans_medium</item>
        <item name="fontFamily">@font/kurinji_sans_medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Kurinji.Body.Large" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/kurinji_sans</item>
        <item name="fontFamily">@font/kurinji_sans</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Kurinji.Body.Medium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/kurinji_sans</item>
        <item name="fontFamily">@font/kurinji_sans</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Kurinji.Body.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/kurinji_sans</item>
        <item name="fontFamily">@font/kurinji_sans</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Kurinji.Label.Large" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/kurinji_sans_medium</item>
        <item name="fontFamily">@font/kurinji_sans_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Kurinji.Label.Medium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/kurinji_sans_medium</item>
        <item name="fontFamily">@font/kurinji_sans_medium</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Kurinji.Label.Small" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/kurinji_sans_medium</item>
        <item name="fontFamily">@font/kurinji_sans_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- A small bold label above a heading (Phase 16: sentence case, no letter-spaced capitals). -->
    <style name="TextAppearance.Kurinji.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/kurinji_display</item>
        <item name="fontFamily">@font/kurinji_display</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===== The names every existing layout uses ===== -->

    <!-- Screen title: one per screen -->
    <style name="TextAppearance.SafeSphere.ScreenTitle" parent="TextAppearance.Kurinji.Headline.Large">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Section title: groups of cards -->
    <style name="TextAppearance.SafeSphere.SectionTitle" parent="TextAppearance.Kurinji.Headline.Small">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Primary information inside a card -->
    <style name="TextAppearance.SafeSphere.CardTitle" parent="TextAppearance.Kurinji.Title.Medium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Body text -->
    <style name="TextAppearance.SafeSphere.Body" parent="TextAppearance.Kurinji.Body.Medium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Secondary / supporting text -->
    <style name="TextAppearance.SafeSphere.Caption" parent="TextAppearance.Kurinji.Body.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Small label above a heading -->
    <style name="TextAppearance.SafeSphere.Overline" parent="TextAppearance.Kurinji.Overline" />

    <!-- Status labels and badges -->
    <style name="TextAppearance.SafeSphere.StatusLabel" parent="TextAppearance.Kurinji.Label.Small" />

    <!-- Buttons -->
    <style name="TextAppearance.SafeSphere.Button" parent="TextAppearance.Kurinji.Label.Large">
        <item name="android:fontFamily">@font/kurinji_display</item>
        <item name="fontFamily">@font/kurinji_display</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- On the dark "hero" panels -->
    <style name="TextAppearance.SafeSphere.Hero.Status" parent="TextAppearance.Kurinji.Headline.Medium">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorOnHero</item>
    </style>

    <style name="TextAppearance.SafeSphere.Hero.Title" parent="TextAppearance.Kurinji.Headline.Small">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?attr/colorOnHero</item>
    </style>

    <style name="TextAppearance.SafeSphere.Hero.Body" parent="TextAppearance.Kurinji.Body.Medium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnHeroVariant</item>
    </style>

    <style name="TextAppearance.SafeSphere.Hero.Overline" parent="TextAppearance.SafeSphere.Overline">
        <item name="android:textColor">?attr/colorOnHeroVariant</item>
    </style>
</resources>
