<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Kurinji "Ink & Lime", light (Phase 17E, decision E17-1, docs/PHASE17E.md, docs/DESIGN_SYSTEM.md).
        Lime (#ADFF2F) is the young growth on the Kurinji hills; ink is the night sky over them.
        Rules:
          * Lime is a FILL (chosen, reacted, saved, the active tab) with ink on it - never text or an icon on a light page
            (it is 1.2:1 on white). On light pages, actions are INK with lime words; accents that must be read are LEAF.
          * In the dark, lime is the action colour with ink words.
          * Red is emergency only again; emergency UI still never relies on colour (U4: black surface, red ring, siren,
            the words). The ss_* / hero_* / emergency_* values below are the Safety section's and are unchanged.
        Every text pair is at least 4.5:1 and every control edge 3:1, day and night (ContrastTest).
    -->

    <!-- Neutrals -->
    <color name="k_page">#F3F4EE</color>
    <color name="k_surface">#FFFFFF</color>
    <color name="k_surface_sunk">#E8EAE1</color>
    <color name="k_surface_low">#F9FAF5</color>
    <color name="k_surface_container">#EDEFE6</color>
    <color name="k_surface_high">#E6E8DE</color>
    <color name="k_surface_highest">#DEE1D5</color>
    <color name="k_ink">#0E100C</color>
    <color name="k_ink_soft">#4A4F44</color>
    <color name="k_outline">#73786C</color>
    <color name="k_line">#DCDFD3</color>
    <!-- Phase 17C: the label on a video still (ink at 85 %): white text on it stays above 12:1 on any picture. -->
    <color name="k_video_badge">#D90E100C</color>
    <!-- The words and play mark on that label: white in light AND dark mode (k_surface turns dark at night). -->
    <color name="k_on_video_badge">#FFFFFF</color>

    <!-- Brand -->
    <color name="k_lime">#ADFF2F</color>
    <color name="k_on_lime">#0E100C</color>
    <!-- The action colour: ink in the day (lime words on it), lime at night (ink words on it). -->
    <color name="k_action">#0E100C</color>
    <color name="k_on_action">#ADFF2F</color>
    <!-- A quiet lime container (tonal buttons, today's state, the selected tab's pill). -->
    <color name="k_lime_soft">#E4F8C4</color>
    <color name="k_on_lime_soft">#1D3000</color>
    <!-- Lime that can be READ on a light page: links, small accents, "Saved". -->
    <color name="k_leaf">#3A6100</color>
    <!-- The ink panel (profile heads, the Safety entry on You): ink with light words and a lime accent. -->
    <color name="k_panel">#0E100C</color>
    <color name="k_on_panel">#F3F4EE</color>
    <color name="k_on_panel_soft">#BFC5B4</color>

    <!-- Emergency (the Material "error" roles) and its own black surface with a red ring. Unchanged since Phase 16. -->
    <color name="ss_emergency">#C8102E</color>
    <color name="ss_on_emergency">#FFFFFF</color>
    <color name="ss_emergency_container">#FDE2E4</color>
    <color name="ss_on_emergency_container">#5C0410</color>
    <color name="emergency_surface">#0B0B0B</color>

    <!-- Status colours of the safety screens (text and icons on the page). Unchanged. -->
    <color name="ss_safe">#187A4B</color>
    <color name="ss_safe_container">#D9F2E3</color>
    <color name="ss_on_safe_container">#0B3D24</color>
    <color name="ss_caution">#8A5A00</color>
    <color name="ss_caution_container">#F3E6C4</color>
    <color name="ss_on_caution_container">#3D2700</color>

    <!-- "Hero" panels of the safety screens (status card, the safety hub head): unchanged. Never red. -->
    <color name="hero_background">#121212</color>
    <color name="hero_on">#F5F4F2</color>
    <color name="hero_on_variant">#BDBDBD</color>
    <color name="hero_accent">#A9C7E8</color>
    <color name="hero_caution">#F5B544</color>

    <!-- ===== IRL "Black Cherry & Cream Vanilla" (2026-11-12, the owner's decision; docs/DESIGN_SYSTEM.md) =====
         The brand's two colours, fixed (launcher icon, opening screen: no night variant). Black Cherry is a very dark red,
         used ONLY by the brand surfaces and the social palette below; it never appears on a safety screen, and bright red
         still means only emergency (ss_emergency, unchanged). -->
    <color name="brand_cherry">#5D0703</color>
    <color name="brand_cream">#EEDCC8</color>
    <!-- The second path of the mark and small accents on cherry. -->
    <color name="brand_blush">#E8A48C</color>
    <!-- The bottom of the launcher icon: cherry fading darker. -->
    <color name="brand_cherry_deep">#2A0302</color>
    <!-- Soft words on the opening screen (always cherry). -->
    <color name="opening_soft">#D9B9A6</color>
    <!-- The SOS shortcut keeps its emergency look (black disc, red ring). -->
    <color name="launcher_red">#D0102A</color>
    <color name="launcher_sos">#121212</color>

    <color name="splash_background">#5D0703</color>

    <!-- ===== The social palette (c_*): only through ThemeOverlay.IRL.Social, which core/ui/SocialPalette puts on the
         social, profile, sign-in and settings screens. Safety screens keep every k_*, ss_*, hero_* value above.
         Day: a cream page, cherry actions with cream words. Night (values-night): a cherry-black page, cream words and
         cream actions; cherry is a SURFACE there (it is 1.5:1 on black, never text). SocialPaletteTest checks the pairs. -->
    <color name="c_page">#EEDCC8</color>
    <color name="c_surface">#FAF3EA</color>
    <color name="c_surface_sunk">#E3CFB8</color>
    <color name="c_surface_low">#F4E8D9</color>
    <color name="c_surface_container">#E9D5BF</color>
    <color name="c_surface_high">#E3CFB8</color>
    <color name="c_surface_highest">#DCC6AE</color>
    <color name="c_ink">#1F0A08</color>
    <color name="c_ink_soft">#5A413A</color>
    <color name="c_outline">#8A6F63</color>
    <color name="c_line">#DCC6AE</color>
    <color name="c_action">#5D0703</color>
    <color name="c_on_action">#EEDCC8</color>
    <!-- The fill of a given mark, a chosen tag, the chosen tab (the role lime has on safety screens). -->
    <color name="c_fill">#5D0703</color>
    <color name="c_on_fill">#EEDCC8</color>
    <color name="c_soft">#E8C9B5</color>
    <color name="c_on_soft">#4A0502</color>
    <color name="c_accent">#5D0703</color>
    <color name="c_panel">#5D0703</color>
    <color name="c_on_panel">#EEDCC8</color>
    <color name="c_on_panel_soft">#D9B9A6</color>

    <!-- Avatar circles (a person's initial when there is no photo): white text reaches 4.5:1 on each. No red. -->
    <color name="avatar_1">#3A6100</color>
    <color name="avatar_2">#0E100C</color>
    <color name="avatar_3">#1E5AA8</color>
    <color name="avatar_4">#00696B</color>
    <color name="avatar_5">#7A3EB1</color>
    <color name="avatar_6">#A34E00</color>
    <color name="avatar_on">#FFFFFF</color>
</resources>
