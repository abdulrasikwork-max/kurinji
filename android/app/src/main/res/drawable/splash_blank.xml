<?xml version="1.0" encoding="utf-8"?>
<!-- IRL (N7, D41): the system launch screen shows only Black Cherry; the IRL signature writes itself once, on the
     opening screen that follows on the same colour (art_opening_signature), so the mark is never shown twice. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="108dp" android:height="108dp" />
</shape>
