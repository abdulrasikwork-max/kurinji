<?xml version="1.0" encoding="utf-8"?>
<!-- IRL opening (N7, D41 / N-133): the IRL signature writes itself in one stroke, in the order a hand writes "irl"
     (120-820 ms), then the dot comes in from out there (the top right) and lands on the i (820-1100 ms): OUT THERE.
     TOGETHER. SplashFragment starts it; with animations switched off the system shows the end state at once.
     Decorative (the lockup carries the words for TalkBack). Fixed colours: the opening is always Black Cherry. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="160dp"
            android:height="160dp"
            android:viewportWidth="72"
            android:viewportHeight="72">
            <group
                android:translateX="-18"
                android:translateY="-18">
                <path
                    android:name="line"
                    android:pathData="M28,65 C31,60 34,55 37,52.5 C36,58 35,63.5 35,67.5 C35,72.5 40,73.5 43,69.5 C45,65 47,57 49,50.5 C50,52.5 51,54.5 52.5,54.5 C54,54.5 56,53 58.5,51 C57.5,57 56,63 56,67.5 C56,72.5 61,73.5 64,69.5 C67,63.5 71,48 71.5,39 C72,32 67.5,30 65.8,34.5 C64,41 63.5,57 64.5,66.5 C65.5,72.5 71,73.5 77,68.5"
                    android:strokeColor="@color/brand_cream"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:strokeWidth="5.4"
                    android:trimPathEnd="0" />
                <group
                    android:name="dot"
                    android:translateX="26"
                    android:translateY="-22">
                    <path
                        android:name="dotFill"
                        android:fillAlpha="0"
                        android:fillColor="@color/brand_blush"
                        android:pathData="M45.2,41.5 A4.7,4.7 0,1 1,35.8,41.5 A4.7,4.7 0,1 1,45.2,41.5 Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="line">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="700"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="120"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>

    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="translateX"
                    android:startOffset="820"
                    android:valueFrom="26"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="translateY"
                    android:startOffset="820"
                    android:valueFrom="-22"
                    android:valueTo="0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="dotFill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="120"
                android:propertyName="fillAlpha"
                android:startOffset="820"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
