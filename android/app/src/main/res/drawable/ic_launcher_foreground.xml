<?xml version="1.0" encoding="utf-8"?>
<!-- IRL launcher icon (2026-11-03), concept "the Meet" (docs/DESIGN_SYSTEM.md "Icon"): two paths, a lime one and a white
     one, rise from different places beyond the edge of the icon and meet at one point, under a lime sun. Two people
     coming together out in the real world; two roads converging on the horizon. The sun sits off-axis on purpose: it is
     the world out there, never a head (the mark is not a figure). Adaptive 108 x 108; the meeting point and the sun stay
     inside the 66-unit safe zone, the paths run on beyond every mask. Fixed colours: the launcher has no night mode. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:name="pathLime"
        android:fillColor="@color/launcher_lime"
        android:pathData="M20,108L20,94C24,66 38,56 49.5,49.5L51.5,52.5C44,59 36,70 36,94L36,108Z" />
    <path
        android:name="pathWhite"
        android:fillColor="@color/launcher_white"
        android:pathData="M80,108L80,94C78,66 64,56 54.5,49.5L52.5,52.5C58,59 65,70 65,94L65,108Z" />
    <path
        android:name="sun"
        android:fillColor="@color/launcher_lime"
        android:pathData="M58,35a9,9 0,1 0,18 0a9,9 0,1 0,-18 0Z" />
</vector>
