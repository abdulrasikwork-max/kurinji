<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: allowBackup="false" stops cloud backups but NOT device-to-device transfer. These rules
    exclude every app file from both, so the sign-in token and the active-emergency record never leave
    this phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
