<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 16: the Android 12+ launch animation (≈600 ms): the stem rises, then the chevron steps forward into place.
     The system skips it when animations are switched off; the end state equals the launcher icon. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.86"
                android:scaleY="0.86"
                android:translateX="-2.5">
                <group
                    android:name="stem"
                    android:pivotX="33.5"
                    android:pivotY="78"
                    android:scaleY="0">
                    <path
                        android:fillColor="@color/launcher_stem"
                        android:pathData="M29,30h9a3,3 0,0 1,3 3v42a3,3 0,0 1,-3 3h-9a3,3 0,0 1,-3 -3v-42a3,3 0,0 1,3 -3z" />
                </group>
                <group
                    android:name="chevron"
                    android:translateX="-18">
                    <path
                        android:name="chevronPath"
                        android:fillAlpha="0"
                        android:fillColor="@color/launcher_chevron"
                        android:pathData="M47,30L63,30L87,54L63,78L47,78L71,54Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="stem">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleY"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>

    <target android:name="chevron">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="340"
                android:interpolator="@android:interpolator/overshoot"
                android:propertyName="translateX"
                android:startOffset="200"
                android:valueFrom="-18"
                android:valueTo="0" />
        </aapt:attr>
    </target>

    <target android:name="chevronPath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:propertyName="fillAlpha"
                android:startOffset="200"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
