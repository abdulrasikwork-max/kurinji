<?xml version="1.0" encoding="utf-8"?>
<!-- IRL (2026-11-03): the Android 12+ launch animation (about 650 ms): the lime path rises, the white path follows and
     meets it, then the sun comes up. The system skips it when animations are switched off; the end state equals the
     launcher icon. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="lime"
                android:translateY="40">
                <path
                    android:name="limePath"
                    android:fillAlpha="0"
                    android:fillColor="@color/launcher_lime"
                    android:pathData="M20,108L20,94C24,66 38,56 49.5,49.5L51.5,52.5C44,59 36,70 36,94L36,108Z" />
            </group>
            <group
                android:name="white"
                android:translateY="40">
                <path
                    android:name="whitePath"
                    android:fillAlpha="0"
                    android:fillColor="@color/launcher_white"
                    android:pathData="M80,108L80,94C78,66 64,56 54.5,49.5L52.5,52.5C58,59 65,70 65,94L65,108Z" />
            </group>
            <group
                android:name="sun"
                android:pivotX="67"
                android:pivotY="35"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:fillColor="@color/launcher_lime"
                    android:pathData="M58,35a9,9 0,1 0,18 0a9,9 0,1 0,-18 0Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="lime">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="translateY"
                android:valueFrom="40"
                android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="limePath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="180"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="white">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="translateY"
                android:startOffset="120"
                android:valueFrom="40"
                android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="whitePath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="180"
                android:propertyName="fillAlpha"
                android:startOffset="120"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="sun">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="260"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="380"
                    android:valueFrom="0"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="260"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="380"
                    android:valueFrom="0"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
